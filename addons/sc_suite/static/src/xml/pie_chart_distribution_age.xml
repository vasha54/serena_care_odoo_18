<?xml version="1.0" encoding="UTF-8" ?>
<templates>


    <t t-name="sc_suite.PieChartDistributionAgeTemplate">
        <div class="card shadow-lg mb-3" style="background-color: #f7f6fb; color: #171a21 !important;">
            <div class="card-body p-2">
                <div class="row">
                    <div class="col-12 text-start">
                        <h6 class="fw-bold" style="margin-left:12px !important; color: #171a21 !important;">
                                Pacientes por Grupo Etáreo
                        </h6>
                        <hr class="my-1"/>
                    </div>
                </div>



                <div class="row align-items-center justify-content-center text-center mb-0">
                    <t t-if="state.loading">
                        <div class="text-center py-4">
                            <i class="fa fa-spinner fa-spin me-2"/>
                Cargando datos…
                        </div>
                    </t>

                    <t t-elif="!state.hasData">
                        <div class="text-center text-muted py-4">
                No hay datos disponibles
                        </div>
                    </t>
                    <t t-else="">
                        <div class="col-6 text-center">
                            <div style="position: relative; height:250px; width:100%;">
                                <canvas t-ref="agePieChart" id="agePieChart"></canvas>
                            </div>
                        </div>
                        <div class="col-6">
                            <t t-foreach="state.legends" t-as="legend" t-index="i_age" t-key="i_age">
                                <div class="row mx-1 my-2 align-items-center">
                                    <div class="col-8">
                                        <div class="d-flex align-items-center">
                                            <span t-att-style="
                            'background-color: ' + legend.color + ';
                             height: 20px;
                             width: 28px;
                             border-radius: 20%;
                             flex-shrink: 0;
                             margin-right: 10px;'
                        ">
                                            </span>
                                            <span t-esc="legend.label"/>
                                        </div>
                                    </div>

                                    <div class="col-4 text-end fw-bold">
                                        <t t-esc="legend.value"/>
                                        (<t t-esc="legend.percent"/>%)
                                    </div>
                                </div>

                                <hr t-if="i !== state.legends.length - 1" class="my-1 mx-1"/>
                            </t>
                        </div>
                    </t>
                </div>


            </div>
        </div>


    </t>

</templates>