<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="sc_suite.CardInfoTimeResidenceTemplate">
        <div class="card shadow-sm mb-2" style="background-color: #da4c64; color: white !important;">
            <div class="card-body p-2">
                <div class="row align-items-center justify-content-center text-center mb-0">
                    <div class="col-4 text-center">
                        <i class="fa fa-calendar me-2 img-fluid rounded-circle" style="max-height: 80px; width: auto; font-size: xxx-large;"></i>
                    </div>
                    <div class="col-8 text-end mt-3">
                        <span class="fw-bold display-6" style="color:white!important;">
                            <t t-esc="state.value"/>
                        </span>
                        <span class="fw-bold display-8" style="color:white!important; margin-left:2px;">
                             <t t-esc="state.unit"/>
                        </span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 text-center">
                        <hr class="my-1" style="border-color: white !important; background-color: white !important; opacity: 1;"/>
                        <span class="fw-bold display-10" style="color:white!important;">
                                Tiempo promedio en las residencias
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>