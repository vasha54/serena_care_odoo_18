<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="sc_suite.CardFilterResidenceTemplate">
        <div class="card shadow-sm mb-2" style="background-color: #56aaf2; color: white !important;">
            <div class="card-body p-2">
                <span class="filter-icon" style="position: absolute; top: 8px; right: 8px; cursor: pointer; z-index: 1; " t-on-click="openFilterResidenceWizard" data-toggle="tooltip" data-placement="top" title="Filtrar residencias">
                    <i class="fa fa-filter" style="color: white; font-size: 1.5rem;"></i>
                </span>
                <div class="row align-items-center justify-content-center text-center mb-0">
                    <div class="col-4 text-center">
                        <i class="fa fa-building-o me-2 img-fluid rounded-circle" style="max-height: 80px; width: auto; font-size: xxx-large;"></i>
                    </div>
                    <div class="col-8 text-end mt-3">
                        <span class="fw-bold display-6" style="color:white!important;">
                            <t t-esc="state.selectedCount"/>
                        </span>
                        <span class="fw-bold display-7" style="color:white!important;">
                         de <t t-esc="state.accessibleCount"/>
                        </span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 text-center">
                        <hr class="my-1" style="border-color: white !important; background-color: white !important; opacity: 1;"/>
                        <span class="fw-bold display-10" style="color:white!important;">
                                Residencias seleccionadas
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- residence_selection_dialog.xml -->
    <t t-name="sc_suite.ResidenceSelectionDialog">
        <Dialog title="props.title" footer="false">
            <div class="modal-body">
                <div class="row">
                    <t t-foreach="props.accessibleResidences" t-as="res" t-key="res.id">
                        <div class="col-12 col-sm-6 col-md-4">
                            <div class="form-check mb-2">
                                <input type="checkbox" class="form-check-input" t-att-id="'residence_' + res.id" t-att-checked="props.initialSelectedIds &amp;&amp; props.initialSelectedIds.includes(res.id)" />
                                <label t-att-for="'residence_' + res.id" class="form-check-label">
                                    <t t-esc="res.name"/>
                                </label>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <t t-slot="footer">
                <div class="modal-footer justify-content-end">
                    <button class="btn btn-secondary" t-on-click="onCancel">Cancelar</button>
                    <button class="btn btn-primary ms-2" t-on-click="confirm">Confirmar</button>
                </div>
            </t>
        </Dialog>
    </t>


</templates>