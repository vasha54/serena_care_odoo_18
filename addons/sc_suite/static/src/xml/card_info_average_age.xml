<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="sc_suite.CardInfoAverageAgeTemplate">
        <div class="card shadow-sm mb-2" style="background-color: #f76975; color: white !important;">
                    <div class="card-body p-2">
                      <div class="row align-items-center justify-content-center text-center mb-0">
                        <div class="col-4 text-center">
                            <i class="fa fa-birthday-cake me-2 img-fluid rounded-circle" 
                                style="max-height: 80px; width: auto; font-size: xxx-large;"></i>
                        </div>
                        <div class="col-8 text-end mt-3">
                            <span class="fw-bold display-6" style="color:white!important;">
                              <t t-esc="state.averageAge"/>
