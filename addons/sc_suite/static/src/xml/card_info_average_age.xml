                            <span class="fw-bold display-8" style="color:white!important;"> años</span>
                        </div>
                      </div>

                      <div class="row">
                        <div class="col-12 text-center">
                            <hr class="my-1" style="border-color: white !important; background-color: white !important; opacity: 1;"/>
