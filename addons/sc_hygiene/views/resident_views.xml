<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View resident form -->
    <record id="view_resident_form_hygiene" model="ir.ui.view">
        <field name="name">Vista Formulario Residente extendida Higiene</field>
        <field name="model">resident</field>
        <field name="inherit_id" ref="sc_resident.view_resident_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//notebook[@name='daily_follow_up']" position="inside">
                <page name="tab_hygiene" string="Higiene" invisible="not id">
                    <group string="Registros" name="register_hygiene">

                        <field name="hygiene_ids" nolabel="1" options="{'create':false, 'edit':false, 'delete':false}">
                            <list default_order="date desc" optional="show"  >
                                <field string="Fecha" name="date" width="120"/>
                                <field string="Registrado" name="user_id"/>
                                <field string="Tipo de higiene" name="hygiene_type_id" />
                                <field string="Tipo de evacuación" name="evacuation_type_str"/>
                                <field string="Descripción" name="description"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>