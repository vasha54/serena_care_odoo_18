<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View medication.inventory View List -->
    <record id="view_medication_inventory_list" model="ir.ui.view">
        <field name="name">Vista Lista de Inventarios de Medicamento</field>
        <field name="model">medication.inventory</field>
        <field name="arch" type="xml">
            <list   create="false" edit="false" delete="false"
                    decoration-danger="available_quantity &lt;= alert_quantity" 
                    decoration-warning="available_quantity &lt;= warning_quantity">
                <field string="Medicamento" name="medicament_id" width="100"/>
                <field string="Forma Farmacéutica" name="pharmaceutical_form" width="100" />
                <field string="Cantidad disponible" name="quantity_str" width="100"/>
                <field name="alert_quantity" column_invisible="1"/>
                <field name="warning_quantity" column_invisible="1"/>
                <field name="available_quantity" column_invisible="1"/>
                <field string="Residente" name="resident_id" width="100"/>
                <field string="Residencia" name="residence_id" />
                <field string="Fecha de la última operación" name="write_date" width="100"/>
                <field name="is_alert" column_invisible="1"/>
                <field name="is_warning" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- View medication.inventory form -->
    <record id="view_medication_inventory_form" model="ir.ui.view">
        <field name="name">Vista Formulario de Inventario de Medicamento</field>
        <field name="model">medication.inventory</field>
        <field name="arch" type="xml">
            <form string="Medication Inventory" create="false" delete="false">
                <sheet>
                    <group col="4" colspan="4">
                        <group col="2" colspan="2" string="Medicamento">
                            <field string="Medicamento" name="medicament_id" readonly="id"/>
                            <field string="Forma farmacéutica" name="pharmaceutical_form" readonly="id"/>
                            <field string="Unidad de medida" name="uom_id" readonly="id" options="{'no_create': True}"/>
                        </group>
                        <group col="2" colspan="2" string="Cantidades">
                            <field string="Disponible" name="available_quantity" readonly="id"/>
                            <field string="Advertir cuando alcance" name="warning_quantity"/>
                            <field string="Alertar cuando alcance" name="alert_quantity"/>
                        </group>
                    </group>
                    <group col="4" colspan="4" string="Motivos del Inventario">
                        <field nolabel="1" name="reason_inventory_compute" readonly="id" rows="7" widget="textarea"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View medication.inventory search -->
    <record id="view_medication_inventory_search" model="ir.ui.view">
        <field name="name">Vista Busqueda Inventario de Medicamento</field>
        <field name="model">medication.inventory</field>
        <field name="arch" type="xml">
            <search>
                <field name="residence_id" />
                <group expand="1" string="Agrupar por">
                        <filter string="Agrupado por residente" name="group_by_resident" domain="[]"
                                    context="{'group_by':'resident_id'}"/>
                        <filter string="Agrupado por medicamento" name="group_by_medicament" domain="[]"
                                    context="{'group_by':'medicament_id'}"/>
                        <filter string="Agrupado por residencia" name="group_by_residence"  domain="[]"
                                    context="{'group_by':'residence_id'}"/>
                </group>
                <filter string="Advertencia de agotamiento" name="notification_warning"  
                    domain="[('is_warning','=',True)]"/>
                <filter string="Alerta de agotamiento" name="notification_alert"  
                    domain="[('is_alert','=',True)]"/>
            </search>
        </field>
    </record>

    <!-- Action medication.inventory -->
    <record id="action_medication_inventory" model="ir.actions.act_window">
        <field name="name">Inventario de Medicamentos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">medication.inventory</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay medicamentos en el inventario.
            </p>
        </field>
    </record>

</odoo>
