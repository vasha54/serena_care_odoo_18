<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_notification_warning_medication_inventory" model="ir.cron">
            <field name="name">Serena Care - Notificación de Inventario de medicamentos en advertencia</field>
            <field name="model_id" ref="model_medication_inventory"/>
            <field name="state">code</field>
            <field name="code">model._notification_status_warning()</field>
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="ir_cron_notification_alert_medication_inventory" model="ir.cron">
            <field name="name">Serena Care - Notificación de Inventario de medicamentos en alerta</field>
            <field name="model_id" ref="model_medication_inventory"/>
            <field name="state">code</field>
            <field name="code">model._notification_status_alert()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>