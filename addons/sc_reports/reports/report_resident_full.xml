<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_resident_full_document" t-name="sc_reports.report_resident_full_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="report_title" t-value="'Reporte Integral del Residente'"/>
                <t t-set="report_subtitle" t-value=""/>
                <t t-call="sc_reports.sc_template_report_layout">

                    <t t-call="sc_reports.section_general"/>
                    <t t-call="sc_reports.section_clinic_history"/>
                    <t t-call="sc_reports.section_medication_inventory_indication"/>
                    <t t-call="sc_reports.section_daily_follow"/>

                </t>
            </t>
        </t>
    </template>


    <record id="report_resident_full_pdf" model="ir.actions.report">
        <field name="name">Reporte Integral del Residente</field>
        <field name="model">resident</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sc_reports.report_resident_full_document</field>
        <field name="report_file">sc_reports.report_resident_full_document</field>
        <field name="print_report_name">'Reporte Integral %s' % (object.name)</field>
    </record>
</odoo>