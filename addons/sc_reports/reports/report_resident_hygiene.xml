<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_resident_hygiene_document" t-name="sc_reports.report_resident_hygiene_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="report_title" t-value="'Reporte de la Higiene del Residente'"/>
                <t t-set="report_subtitle" t-value=""/>
                <t t-set="hygienes" t-value="doc.hygiene_ids"/>
                <t t-call="sc_reports.sc_template_report_layout">

                    <t t-call="sc_reports.section_resident_info_basic"/>

                    
                    <div class="row mt-5">
                        <div class="col-12 pe-1 ps-1">
                            <h5 class="section-title">Registros</h5>
                        </div>
                    </div>

                    <div class="row mt-3">

                        <div class="col-12 pe-1 ps-1">
                            <t t-if="hygienes">
                                <table class="table table-sm mt-3">
                                    <tr>
                                        <td class="text-center" style="width:20%;">
                                            <strong>Fecha</strong>
                                        </td>
                                        <td class="text-center" style="width:20%;">
                                            <strong>Registrado</strong>
                                        </td>
                                         <td class="text-center" style="width:20%;">
                                            <strong>Tipo de higiene</strong>
                                        </td>
                                        <td class="text-center" style="width:20%;">
                                            <strong>Tipo de evacuación</strong>
                                        </td>    
                                        <td class="text-center" style="width:20%;">
                                            <strong>Descripción</strong>
                                        </td>
                                    </tr>
                                    <t t-foreach="hygienes" t-as="record">
                                        <tr>
                                            <td class="text-center" style="width:20%;">
                                                <t t-esc="record.date_user" />
                                            </td>
                                            <td class="text-start" style="width:20%;">
                                                <t t-esc="record.user_id.name" />
                                            </td>
                                            <td class="text-start" style="width:20%;">
                                                <t t-esc="record.hygiene_type_id.name" />
                                            </td>
                                            <td class="text-start" style="width:20%;">
                                                <t t-esc="record.evacuation_type_str" />
                                            </td>
                                            <td class="text-start" style="width:20%;">
                                                <t t-esc="record.description" />
                                            </td>
                                        </tr> 
                                    </t>
                                </table>
                            </t>
                            <t t-else="">
                                <p class="text-center">El residente no tiene ningún registro de Higiene.</p>
                            </t>
                        </div>
                    </div>


                </t>
            </t>
        </t>
    </template>

    <record id="report_resident_hygiene_pdf" model="ir.actions.report">
        <field name="name">Reporte del Higiene del Residente</field>
        <field name="model">resident</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sc_reports.report_resident_hygiene_document</field>
        <field name="report_file">sc_reports.report_resident_hygiene_document</field>
        <field name="print_report_name">'Reporte de la Higiene del Residente %s' % (object.name)</field>
    </record>
</odoo>