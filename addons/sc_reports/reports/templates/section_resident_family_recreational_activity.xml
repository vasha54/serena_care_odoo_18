<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="section_resident_family_recreational_activity">
        <t t-set="activitys_recreations" t-value="context.get('wizard_activitys_recreations')"/>
        <h5 class="section-title">Actividades Recreativas</h5>

        <div class="row mt-3">

            <div class="col-12 pe-1 ps-1">
                <t t-if="activitys_recreations">
                    <table class="table table-sm mt-3">
                        <tr>
                            <td class="text-center" style="width:25%;">
                                <strong>Fecha</strong>
                            </td>
                            <td class="text-center" style="width:25%;">
                                <strong>Tipo de actividad</strong>
                            </td>
                            <td class="text-start" style="width:25%;">
                                <strong>Registrado</strong>
                            </td>
                            <td class="text-start" style="width:25%;">
                                <strong>Descripción</strong>
                            </td>
                        </tr>
                        <t t-foreach="activitys_recreations" t-as="activity">
                            <tr>
                                <td class="text-center" style="width:25%;">
                                    <t t-esc="activity['date']" />
                                </td>
                                <td class="text-center" style="width:25%;">

                                    <div style="display: flex; align-items: center; justify-content: center; gap: 8px;">
                                        <t t-if="activity['type_image']">
                                            <img t-att-src="'data:image/png;base64,' + activity['type_image']" style="max-height: 32px; max-width: 32px; object-fit: contain;"/>
                                        </t>
                                        <span t-esc="activity['type_name']"/>
                                    </div>
                                </td>
                                <td class="text-start" style="width:25%;">
                                    <t t-esc="activity['user']" />
                                </td>
                                <td class="text-start" style="width:25%;">
                                    <t t-esc="activity['description']" />
                                </td>
                            </tr>
                        </t>
                    </table>
                </t>
                <t t-else="">
                    <p class="text-center">El residente no ha participado en ninguna actividad en el período.</p>
                </t>
            </div>
        </div>
    </template>

</odoo>
