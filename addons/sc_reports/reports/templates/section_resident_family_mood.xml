<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="section_resident_family_mood">
        <t t-set="moods" t-value="context.get('wizard_assessment_moods')"/>
        <t t-set="predominant_moods" t-value="context.get('wizard_predominant_mood')"/>
        <h5 class="section-title">Ánimo</h5>

        <h6 class="subsection-title">Estados predominantes</h6>

        <t t-if="predominant_moods">
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;">
                <t t-foreach="predominant_moods" t-as="mood">
                    <div style="display: flex; align-items: center; justify-content: center; gap: 8px;">
                        <t t-if="mood['image']">
                            <img t-att-src="'data:image/png;base64,' + mood['image']" style="max-height: 64px; max-width: 64px; object-fit: contain;"/>
                        </t>
                        <span style="margin-left:10px;" t-esc="mood['name']"/>
                    </div>
                </t>
            </div>
        </t>

        <t t-else="">
            <p>El residente no tuvo un estado de ánimo predominate en este período</p>
        </t>

