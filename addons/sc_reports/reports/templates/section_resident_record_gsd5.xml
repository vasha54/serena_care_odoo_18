<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="section_resident_record_gsd5">
        <t t-set="records" t-value="doc.scalegds5_assessment_ids"/>
        <h5 class="section-title mt-0 pt-0">Evaluación de GSD-5</h5>

        <h6 class="subsection-title">Registros</h6>
        <t t-if="records">
            <table class="table table-sm mt-3">
                <tr>
                    <td class="text-center" style="width:16%;">
                        <strong>Fecha</strong>
                    </td>
                    <td class="text-center" style="width:16%;">
                        <strong>Registrado</strong>
                    </td>
                    <td class="text-center" style="width:16%;">
                        <strong>Cant. Preguntas</strong>
                    </td>
                    <td class="text-center" style="width:16%;">
                        <strong>Puntuación</strong>
                    </td>
                    <td class="text-center" style="width:16%;">
                        <strong>Estado de ánimo</strong>
                    </td>
                    <td class="text-center" style="width:16%;">
                        <strong>Nota clínica</strong>
                    </td>
                </tr>
                <t t-foreach="records" t-as="r">
                    <tr>
                        <td class="text-center" style="width:16%;">
                            <t t-esc="r.date_user"/>
                        </td>
                        <td class="text-start" style="width:16%;">
                            <t t-esc="r.user_id.name"/>
                        </td>
                        <td class="text-center" style="width:16%;">
                            <t t-esc="r.total_questions"/>
                        </td>
                        <td class="text-center" style="width:16%;">
                            <t t-esc="r.total_score"/>
                        </td>
                        <td class="text-center" style="width:16%;">
                            <t t-esc="r.scalegds5_state_display"/>
                        </td>
                        <td class="text-start" style="width:16%;">
                            <t t-esc="r.clinic_note"/>
                        </td>
                    </tr>
                </t>
            </table>
        </t>

        <t t-else="">
            <p>El residente no tiene registros de evaluación de GSD-5</p>
        </t>
    </template>

</odoo>