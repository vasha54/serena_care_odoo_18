<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="section_resident_record_norton">
        <t t-set="records" t-value="doc.norton_assessment_ids"/>
        <h5 class="section-title mt-0 pt-0">Evaluación de Norton</h5>

        <h6 class="subsection-title">Registros</h6>
        <t t-if="records">
            <table class="table table-sm mt-3">
                <tr>
                    <td class="text-center" style="width:11%;">
                        <strong>Fecha</strong>
                    </td>
                    <td class="text-center" style="width:11%;">
                        <strong>Registrado</strong>
                    </td>
                    <td class="text-center" style="width:11%;">
                        <strong>Puntuación Total</strong>
                    </td>
                    <td class="text-center" style="width:11%;">
                        <strong>Nivel de Riesgo</strong>
                    </td>
                    <td class="text-center" style="width:11%;">
                        <strong>Estado Físico</strong>
                    </td>
                    <td class="text-center" style="width:11%;">
                        <strong>Estado Mental</strong>
                    </td>
                    <td class="text-center" style="width:11%;">
                        <strong>Actividad</strong>
                    </td>
                    <td class="text-center" style="width:11%;">
                        <strong>Movilidad</strong>
                    </td>
                    <td class="text-center" style="width:11%;">
                        <strong>Incontinencia</strong>
                    </td>
                </tr>
                <t t-foreach="records" t-as="r">
                    <tr>
                        <td class="text-center" style="width:11%;">
                            <t t-esc="r.date_user"/>
                        </td>
                        <td class="text-start" style="width:11%;">
                            <t t-esc="r.user_id.name"/>
                        </td>
                        <td class="text-center" style="width:11%;">
                            <t t-esc="r.total_score"/>
                        </td>
                        <td class="text-center" style="width:11%;">
                            <t t-esc="r.risk_level_label"/>
                        </td>
                        <td class="text-center" style="width:11%;">
                            <t t-esc="r.physical_condition_label"/>
                        </td>
                        <td class="text-center" style="width:11%;">
                            <t t-esc="r.mental_state_label"/>
                        </td>
                        <td class="text-center" style="width:11%;">
                            <t t-esc="r.activity_label"/>
                        </td>
                        <td class="text-center" style="width:11%;">
                            <t t-esc="r.mobility_label"/>
                        </td>
                        <td class="text-center" style="width:11%;">
                            <t t-esc="r.incontinence_label"/>
                        </td>
                    </tr>
                </t>
            </table>
        </t>

        <t t-else="">
            <p>El residente no tiene registros de evaluación de Norton</p>
        </t>
    </template>

</odoo>