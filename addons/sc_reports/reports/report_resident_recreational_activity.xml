<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_resident_recreational_activity_document" t-name="sc_reports.report_resident_recreational_activity_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="report_title" t-value="'Reporte del Actividades de Recreativas del Residente'"/>
                <t t-set="report_subtitle" t-value=""/>
                <t t-set="activitys_recreations" t-value="doc.last_7_days_activities"/>
                <t t-call="sc_reports.sc_template_report_layout">

                    <h5 class="section-title">Información General</h5>
                    <t t-call="sc_reports.section_resident_info_basic"/>

                    <div class="row mt-5">
                        <div class="col-12 pe-1 ps-1">
                            <h5 class="section-title"> Participación en Actividades (Últimos 7 días)</h5>
                        </div>
                    </div>

                    <div class="row mt-3">

                        <div class="col-12 pe-1 ps-1">
                            <t t-if="activitys_recreations">
                                <table class="table table-sm mt-3">
                                    <tr>
                                        <td class="text-center" style="width:15%;">
                                            <strong>Fecha</strong> 
                                        </td>
                                        <td class="text-center" style="width:15%;">
                                            <strong>Tipo de actividad</strong> 
                                        </td>
                                        <td class="text-start" style="width:35%;">
                                            <strong>Registrado</strong>
                                        </td>
                                        <td class="text-start" style="width:35%;">
                                            <strong>Descripción</strong>
                                        </td>
                                    </tr>
                                    <t t-foreach="activitys_recreations" t-as="activity">
                                        <tr>
                                            <td class="text-center" style="width:15%;">
                                                <t t-esc="activity.date_execution_user" />
                                            </td>
                                            <td class="text-center" style="width:15%;">
                                                <t t-esc="activity.activity_type_id.name" />
                                            </td>
                                            <td class="text-start" style="width:35%;">
                                                <t t-esc="activity.user_id.name" />
                                            </td>
                                            <td class="text-start" style="width:35%;">
                                                <t t-esc="activity.description" />
                                            </td>
                                        </tr>
                                    </t>
                                </table>
                            </t>
                            <t t-else="">
                                <p class="text-center">El residente no ha participado en ninguna actividad en los últimos días.</p>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>




    <record id="report_resident_recreational_activity_pdf" model="ir.actions.report">
        <field name="name">Reporte de las Actividades de Recreativas del Residente</field>
        <field name="model">resident</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sc_reports.report_resident_recreational_activity_document</field>
        <field name="report_file">sc_reports.report_resident_recreational_activity_document</field>
        <field name="print_report_name">'Reporte de las Actividades de Recreativas del Residente %s' % (object.name)</field>
    </record>
</odoo>