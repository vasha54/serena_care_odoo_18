<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_resident_family_document" t-name="sc_reports.report_resident_family_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="report_title" t-value="'Reporte al Familiar del Residente'"/>
                <t t-set="report_subtitle" t-value=""/>
                <t t-set="date_start" t-value="context.get('wizard_date_start')"/>
                <t t-set="date_end" t-value="context.get('wizard_date_end')"/>
                <t t-call="sc_reports.sc_template_report_layout">

                    <t t-call="sc_reports.section_resident_info_basic"/>
                    <p>
                        <strong>Período del informe:</strong>
                        <span t-esc="date_start"/>
    -
                        <span t-esc="date_end"/>
                    </p>
                    <t t-call="sc_reports.section_resident_family_recreational_activity"/>
                    <t t-call="sc_reports.section_resident_family_nutrition"/>
                    <t t-call="sc_reports.section_resident_family_mood"/>
                    <t t-call="sc_reports.section_resident_family_extra_information"/>

                </t>
            </t>
        </t>
    </template>


    <record id="report_resident_family_pdf" model="ir.actions.report">
        <field name="name">Reporte al Familiar del Residente</field>
        <field name="model">resident</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sc_reports.report_resident_family_document</field>
        <field name="report_file">sc_reports.report_resident_family_document</field>
        <field name="print_report_name">'Reporte al Familiar del Residente %s' % (object.name)</field>
    </record>
</odoo>