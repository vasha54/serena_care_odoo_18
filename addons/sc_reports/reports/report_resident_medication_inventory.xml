<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_resident_medication_inventory_document" t-name="sc_reports.report_resident_medication_inventory_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="report_title" t-value="'Reporte del Inventario de los Medicamentos del Residente'"/>
                <t t-set="report_subtitle" t-value=""/>
                <t t-set="operations_inventory" t-value="context.get('operations_inventory', False)"/>
                <t t-set="medication_inventory" t-value="doc.medication_inventory_ids"/>
                <t t-call="sc_reports.sc_template_report_layout">

                    <t t-call="sc_reports.section_resident_info_basic"/>

                    <div class="row mt-5">
                        <div class="col-12 pe-1 ps-1">
                            <h5 class="section-title">Inventario</h5>
                        </div>
                    </div>

                    <div class="row mt-5">
                        <div class="col-12 pe-1 ps-1">

                            <t t-if="medication_inventory">

                                <table class="table table-sm mt-3">
                                    <tr>
                                        <td style="width:35%">
                                            <strong>Medicamento</strong>
                                        </td>
                                        <td style="width:35%">
                                            <strong>Forma Farmacéutica</strong>
                                        </td>
                                        <td style="width:30%">
                                            <strong>Cantidad disponible</strong>
                                        </td>
                                    </tr>
                                    <t t-foreach="medication_inventory" t-as="inventory">
                                        <tr>
                                            <td style="width:35%">
                                                <t t-esc="inventory.medicament_id.name"/>
                                            </td>
                                            <td style="width:35%">
                                                <t t-esc="inventory.pharmaceutical_form"/>
                                            </td>
                                            <td style="width:30%">
                                                <t t-esc="inventory.quantity_str"/>
                                            </td>
                                        </tr>
                                    </t>
                                </table>


                            </t>
                            <t t-else="">
                                <p class="text-center">El residente no tiene Inventario de Medicamento</p>
                            </t>

                        </div>
                    </div>

