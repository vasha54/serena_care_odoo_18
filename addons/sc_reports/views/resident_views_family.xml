<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_resident_form_family_report" model="ir.ui.view">
        <field name="name">Vista Formulario de Residente extendida Reporte Familiar</field>
        <field name="model">resident</field>
        <field name="inherit_id" ref="sc_resident.view_resident_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='group_register_family']" position="after">
                <group name="group_report_family" string="Reporte" col="2" colspan="2">
                    <group>
                        <button name="action_family_report_pdf" 
                                string="Informe al familiar (PDF)" type="object" class="oe_stat_button" 
                                invisible="not id" icon="fa-file-pdf-o"/>
                    </group>
                    <group>
                    </group>
                </group>
                <!-- <button name="action_export_care_plan_pdf" string="Exportar Plan de Cuidado (PDF)" type="object" class="oe_stat_button" invisible="not care_plan_id" icon="fa-file-pdf-o"/> -->

                <!-- <button name="action_export_care_plan_xlsx" string="Exportar Plan de Cuidado (Excel)" type="object" class="oe_stat_button" invisible="not care_plan_id" icon="fa-file-excel-o"/> -->
            </xpath>

        </field>
    </record>

</odoo>
