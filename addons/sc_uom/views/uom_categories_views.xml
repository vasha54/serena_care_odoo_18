<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción para Categorías de Unidades de Medida -->
    <record id="action_uom_categories" model="ir.actions.act_window">
        <field name="name">Categorías de Unidades</field>
        <field name="res_model">uom.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("is_uom_sc","=",True)]</field>
        <field name="context">{'uom_sc': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea una nueva categoría
            </p>
        </field>
    </record>
</odoo>