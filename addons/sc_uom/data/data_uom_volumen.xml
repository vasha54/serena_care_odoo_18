<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
    <!-- Categoría Volumen -->
    <record id="uom_categ_volume" model="uom.category">
        <field name="name">Volumen</field>
        <field name="is_uom_sc" eval="True"/>
    </record>

    <!-- Unidad de referencia: Litro -->
    <record id="uom_volume_liter" model="uom.uom">
