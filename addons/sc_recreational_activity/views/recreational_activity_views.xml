<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View recreational.activity View List -->
    <record id="view_recreational_activity_list" model="ir.ui.view">
        <field name="name">Vista Lista de Actividades Recreativas</field>
        <field name="model">recreational.activity</field>
        <field name="arch" type="xml">
            <list default_order="date_execution desc" create="false" edit="false" delete="false">
                <field string="Fecha y Hora" name="date_execution"/>
                <field string="Tipo de actividad" name="activity_type_id"/>
                <field string="Registrado" name="user_id" />
                <field string="Residentes" name="residents" widget="many2many_tags"/>
                <field string="Residentes" name="residents_str" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- View recreational.activity form -->
    <record id="view_recreational_activity_form" model="ir.ui.view">
        <field name="name">Vista Formulario de Actividad Recreativa</field>
        <field name="model">recreational.activity</field>
        <field name="arch" type="xml">
            <form string="Recreational Activity" create="false" edit="false" delete="false">
                <sheet>
                    <group >
                        <group>
                            <field string="Fecha y Hora" name="date_execution"/>
                            <field string="Tipo de actividad" name="activity_type_id"/>
                        </group>
                        <group>
                            <field string="Registrado" name="user_id" />
                        </group>
                    </group>
                    <notebook>
                        <page name="description_tab" string="Descripción">
                            <field nolabel="1" name="description" widget="text" rows="5"/>
                        </page>
                        <page name="residents_tab" string="Residentes">
                            <field name="residents" nolabel="1" >
                                <list create="false" edit="false" remove="false">
                                    <field name="name" />
                                    <field name="age" />
                                    <field name="sex_id" />
                                    <field name="residence_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View recreational.activity search -->
    <record id="view_recreational_activity_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda de Actividad Recreativa</field>
        <field name="model">recreational.activity</field>
        <field name="arch" type="xml">
            <search>
                <field string="Residentes" name="residents_str" />
                <filter string="Hoy" name="today" 
                        domain="[('date_execution','&gt;=', context_today().start_of('day')), 
                        ('date_execution','&lt;=', context_today().end_of('day'))]"/>
                <filter string="Últimos 7 días" name="last_week" 
                        domain="[('date_execution','&gt;=', context_today() - datetime.timedelta(days=7))]"/>
                <filter string="Último mes" name="last_month" 
                        domain="[('date_execution','&gt;=', context_today() - datetime.timedelta(days=30))]"/>
                <filter string="Último año" name="last_year" 
                        domain="[('date_execution','&gt;=', context_today() - datetime.timedelta(days=365))]"/>
                <filter string="Rango de fechas" name="date_range" 
                        date="date_execution"/>
                <filter string="Agrupado por mes" name="group_by_month" 
                        context="{'group_by':'date_execution:month'}"/>
                <group expand="1" string="Agrupar por">
                    <filter string="Tipo de actividad" name="activity_type_group" domain="[]" context="{'group_by':'activity_type_id'}"/>
                    <filter string="Registrado" name="user_id_group" domain="[]" context="{'group_by':'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action recreational.activity -->
    <record id="action_recreational_activity" model="ir.actions.act_window">
        <field name="name">Actividades Recreativas</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">recreational.activity</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registro de Actividades Recreativas.
            </p>
        </field>
    </record>

    <record id="action_report_recreational_activity_pdf" model="ir.actions.report">
        <field name="name">Reporte de Actividades Recreativas (PDF)</field>
        <field name="model">recreational.activity</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sc_recreational_activity.report_recreational_activity</field>
        <field name="print_report_name">'Reporte_Actividades_Recreativas_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_recreational_activity"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_recreational_activity_xlsx" model="ir.actions.server">
        <field name="name">Reporte de Actividades Recreativas (Excel)</field>
        <field name="model_id" ref="model_recreational_activity"/>
        <field name="binding_model_id" ref="model_recreational_activity"/>
        <field name="binding_type">report</field>
        <field name="state">code</field>
        <field name="code">
            action = model.export_xlsx()
        </field>
    </record>

        

</odoo>
