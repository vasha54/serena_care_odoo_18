<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- View residence_res_user View List -->
    <record id="view_residence_res_user_list" model="ir.ui.view">
        <field name="name">Vista Lista de Usuarios</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list default_order="name asc" decoration-muted="active == False" >
                <field string="Estado" name="active" widget="boolean_toggle"
/>
                <field string="Nombre" name="name" />
                <field string="Usuario" name="login" />
                <field string="Correo" name="email"/>
                <field string="Roles" name="serena_group_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_open': True}"/>
                <field string="Residencia" name="residence_name"/>
                <field name="create_date"  string="Creado" />
                <button 
                        name="action_view_details" 
                        type="object" 
                        icon="fa-eye" 
                        class="btn btn-link"
                        string=""
                        title="Ver detalles"/>
                <button 
                        name="action_edit" 
                        type="object" 
                        icon="fa-pencil" 
                        class="btn btn-link"
                        string=""
                        title="Editar"/>

            </list>
        </field>
    </record>


    <record id="view_residence_res_user_list_delete" model="ir.ui.view">
        <field name="name">Vista Lista de Usuarios de Eliminados</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list default_order="name asc" create="false" edit="false" delete="false">
                <field string="Estado" name="active" widget="boolean_toggle"/>
                <field string="Nombre" name="name" />
                <field string="Usuario" name="login" />
                <field string="Correo" name="email"/>
                <field string="Roles" name="serena_group_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_open': True}"/>
                <field string="Residencia" name="residence_name"/>
                <field name="create_date"  string="Creado" />
            </list>
        </field>
    </record>

    <!-- View residence_res_user form -->
    <record id="view_residence_res_user_form" model="ir.ui.view">
        <field name="name">Vista Formulario del Usuario</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="Res user" context="{'user_serena_care':True}">
                <header><field name="share" invisible="1"/>
                    <field name="employee_id" invisible="1"/>
                        <button 
                            name="toggle_active" 
                            type="object"
                            class="oe_highlight btn-danger"
                            invisible="not active or not id" 
                            string="Desactivar usuario"
                        />                    
                        <button 
                            name="toggle_active" 
                            type="object"
                            class="oe_highlight btn-success"
                            invisible="active or not id" 
                            string="Activar usuario"
                        />

                    <button context="{'employee_serena_care':True ,'user_serena_care':True }" string="Crear un empleado de residencia asociado a este usuario" type="object" name="action_create_employee" invisible="not id or share or employee_id"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="alert alert-info text-center o_form_header" invisible="active and active_partner or not active and not active_partner or active and not active_partner" role="alert">
                        <a class="close" data-bs-dismiss="alert" href="#">x</a>
                        <div>
                            <strong>El contacto vinculado a este usuario sigue activo</strong>
                        </div>
                        <div>Puedes archivar el contacto
                            <field name="partner_id" required="0" readonly="1"/>
                        </div>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre completo" required="1"/>
                        </h1>
                        <group>
                            <field name="login" string="Usuario" required="1" readonly="id"/>
                        </group>
                    </div>
                    <notebook>
                        <page string="Información">
                            <group>
                                <group string="Contraseña">
                                    <field name="password" password="True" string="Contraseña" required="not id"/>
                                    <field name="confirmed_password" password="True" string="Confirmar Contraseña" required="not id"/>
                                </group>
                                <group name="info" string="Información Básica">
                                    <field name="email" string="Correo electrónico"/>
                                    <field name="mobile" string="Teléfono móvil"/>
                                    <field name="phone" string="Teléfono"/>
                                    <field name="residence_name" readonly="1" />
                                    
                                </group>
                            </group>
                        </page>
                        
                        <page string="Roles de Serena Care">
                            <group>
                                <field name="serena_group_ids" widget="many2many_tags"
                                       options="{'no_create': True, 'color_field': 'color'}"
                                       string="Seleccionar Roles"/>
                            </group>
                            <!-- Jerarquía de roles (solo visual) -->
                            <group string="Jerarquía de Roles" invisible="not serena_group_ids">
                                <!-- Alerta con icono -->
                                <div class="row g-3">
                                    <div class="alert alert-info w-100 mb-4 d-flex align-items-center" role="alert">
                                        <i class="fa fa-info-circle fa-lg mr-3"></i>
                                        <div>
                                            <strong class="d-block">Información sobre permisos</strong>
                                            Los roles heredan permisos de sus roles padre. Los roles subordinados tienen acceso a todas las funcionalidades del rol principal.
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Contenedor de fila -->
                                <div class="row g-3"> <!-- g-3 para gutter (espaciado entre columnas) -->
                                    <!-- Columna Administración -->
                                    <div class="col-lg-4 col-md-6">
                                        <div class="card h-100 border-primary" invisible="not has_gs_admin">
                                            <div class="card-header bg-primary text-white d-flex align-items-center">
                                                <i class="fa fa-shield fa-lg mr-2"></i>
                                                <h5 class="mb-0">Administración</h5>
                                            </div>
                                            <div class="card-body">
                                                <div class="list-group list-group-flush">
                                                    <div class="list-group-item d-flex align-items-center" invisible="not has_gs_admin_direccion">
                                                        <i class="fa fa-check text-success mr-2"></i>
                                                        <span>Dirección</span>
                                                    </div>
                                                    <div class="list-group-item d-flex align-items-center" invisible="not has_gs_admin_gerente_ti">
                                                        <i class="fa fa-check text-success mr-2"></i>
                                                        <span>Gerente de TI</span>
                                                    </div>
                                                    <div class="list-group-item d-flex align-items-center" invisible="not has_gs_admin_gerente_enfermeria">
                                                        <i class="fa fa-check text-success mr-2"></i>
                                                        <span>Gerente de enfermería</span>
                                                    </div>
                                                    <div class="list-group-item d-flex align-items-center" invisible="not has_gs_admin_coordinadora_enfermeria">
                                                        <i class="fa fa-check text-success mr-2"></i>
                                                        <span>Coordinadora de enfermería</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Columna Gerente Salud -->
                                    <div class="col-lg-4 col-md-6">
                                        <div class="card h-100 border-success" invisible="not has_gs_gerente_salud">
                                            <div class="card-header bg-success text-white d-flex align-items-center">
                                                <i class="fa fa-user-md fa-lg mr-2"></i>
                                                <h5 class="mb-0">Gerente Salud</h5>
                                            </div>
                                            <div class="card-body">
                                                <div class="list-group list-group-flush">
                                                    <div class="list-group-item d-flex align-items-center" invisible="not has_gs_gerente_salud_medico">
                                                        <i class="fa fa-check text-success mr-2"></i>
                                                        <span>Médico</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Columna Enfermería -->
                                    <div class="col-lg-4 col-md-12">
                                        <div class="card h-100 border-danger" invisible="not has_gs_enfermeria">
                                            <div class="card-header bg-danger text-white d-flex align-items-center">
                                                <i class="fa fa-heartbeat fa-lg mr-2"></i>
                                                <h5 class="mb-0">Enfermería</h5>
                                            </div>
                                            <div class="card-body">
                                                <div class="list-group list-group-flush">
                                                    <div class="list-group-item d-flex align-items-center" invisible="not has_gs_enfermeria_cuidador">
                                                        <i class="fa fa-check text-success mr-2"></i>
                                                        <span>Cuidador</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </group>
                        </page>
                        
                        <page string="Auditoría" invisible="not id">
                            <group>
                                <field name="password_reset_attempts" string="Intentos de Reset" readonly="1"/>
                                <field name="last_password_reset_attempt" string="Último Intento" readonly="1"/>
                                <field name="write_date" string="Última Modificación" readonly="1"/>
                                <field name="create_date" string="Fecha de Creación" readonly="1"/>
                                <field name="state" widget="badge" decoration-info="state == 'new'" decoration-success="state == 'active'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_residence_res_user_form_delete" model="ir.ui.view">
        <field name="name">Vista Formulario de Usuario Eliminado</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="Res user"  create="false" edit="false" delete="false">
                <header><field name="share" invisible="1"/>
                    <field name="employee_id" invisible="1"/>
                    <button string="Restaurar usuario" invisible="not is_deleted" name="action_restore" type="object" class="oe_highlight"/>
                    
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="alert alert-info text-center o_form_header" invisible="active and active_partner or not active and not active_partner or active and not active_partner" role="alert">
                        <a class="close" data-bs-dismiss="alert" href="#">x</a>
                        <div>
                            <strong>El contacto vinculado a este usuario sigue activo</strong>
                        </div>
                        <div>Puedes archivar el contacto
                            <field name="partner_id" required="0" readonly="1"/>
                        </div>
                    </div>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. John Doe" required="1"/></h1>
                        <label for="login" string="Usuario"/>
                        <h2><field name="login" placeholder="e.g. email@yourcompany.com" readonly="id"/></h2>
                    </div>
                    <group col="3" colspan="3">
                        <group name="credential" string="Credenciales">
                            <field string="Contraseña" name="password" widget="password"/>
                            <field string="Confirmar contraseña" name="confirmed_password" widget="password"/>
                        </group>
                        <group name="group_roles" string="Grupos de Accesos">
                            <field  nolabel="1" string="Grupos de accesos" name="groups_id" widget="many2many_tags" options="{'no_create': True, 'no_create_edit': True}"/>    
                        </group>
                        <group name="info" string="Información Básica">
                            <field name="email" string="Correo electrónico" required="1"/>
                            <field name="mobile" string="Teléfono móvil"/>
                            <field name="phone" string="Teléfono"/>
                            <field name="residence_name" readonly="1" />
                            <field name="create_date"  string="Creado" readonly="1"/>
                            <field name="write_date"  string="Última modificación" readonly="1"/>
                            <field name="login_date" string="Último acceso" readonly="1"/>
                            <field name="state" widget="badge" decoration-info="state == 'new'" decoration-success="state == 'active'"/>
                        </group>
                    </group>    
                </sheet>
            </form>
        </field>
    </record>

    <!-- View residence_res_user search -->
    <record id="view_residence_res_user_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda de Usuario</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <search>
                <field name="create_date" string="Creado"/> 
                <field name="group_names" string="Grupo"/>
                <field name="name"  string="Nombre" />
                <field name="email" string="Correo" />
                <filter name="inactive" string="Usuarios inactivos" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

        
    <!-- Action residence_res_user -->
    <record id="action_residence_res_user" model="ir.actions.act_window">
        <field name="name">Listado de los usuarios</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("is_user_sc","=",True),("is_deleted","=",False)]</field>
        <field name="context">{'active_test': False, 'user_serena_care':True }</field>
        <field name="search_view_id" ref="view_residence_res_user_search" />
        <field name="view_ids" eval="[ (5, 0, 0), 
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_residence_res_user_list')}), 
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_residence_res_user_form')})]"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent">
                No se encontraron usuarios con esos criterios.
            </p>
        </field>
    </record>

    <record id="action_residence_res_user_delete" model="ir.actions.act_window">
        <field name="name">Listado de los usuarios eliminados</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[("is_user_sc","=",True),("is_deleted","=",True)]</field>
        <field name="context">{'active_test': False, 'user_serena_care':True }</field>
        <field name="search_view_id" ref="view_residence_res_user_search" />
        <field name="view_ids" eval="[ (5, 0, 0), 
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_residence_res_user_list_delete')}), 
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_residence_res_user_form_delete')})]"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent">
                No se encontraron usuarios con esos criterios.
            </p>
        </field>
    </record>
    
</odoo>
