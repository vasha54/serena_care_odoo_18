<?xml version="1.0" encoding="utf-8"?>
<odoo>



    <!-- View change.photo.employee.wizard form -->
    <record id="view_change_photo_employee_wizard_form" model="ir.ui.view">
        <field name="name">Vista Wizard Cambiar Foto del Empleado</field>
        <field name="model">change.photo.employee.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Photo employee Wizard">
                <sheet>
                    <field name="current_employee_id" invisible="1"/>
                    <group>
                        <group string="Foto actual">
                            <field name="current_image_1920" nolabel="1" widget="image"/>
                        </group>
                        <group string="Nueva foto">
                            <field name="new_image_1920" nolabel="1" widget="image"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button 
                        name="action_change_photo_employee" 
                        string="Actualizar imagen" 
                        type="object" 
                        class="btn-primary"/>
                    <button 
                        string="Cancelar" 
                        special="cancel" 
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    



</odoo>
