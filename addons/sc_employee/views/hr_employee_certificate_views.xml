<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View hr.employee.certificate View List -->
    <record id="view_hr_employee_certificate_list" model="ir.ui.view">
        <field name="name">Vista Lista de Certificados del Empleado</field>
        <field name="model">hr.employee.certificate</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Vista kanban para certificados -->
    <record id="view_hr_employee_certificate_kanban" model="ir.ui.view">
        <field name="name">Vista Kaban de Certificados del Empleado</field>
        <field name="model">hr.employee.certificate</field>
        <field name="arch" type="xml">
            <kanban default_group_by="employee_id">
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_title">
                                    <field name="name"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <strong>Institución:</strong>
                                    <field name="institution"/>
                                </div>
                                <div>
                                    <strong>Emisión:</strong>
                                    <field name="issue_date"/>
                                </div>
                                <div>
                                    <strong>Expiración:</strong>
                                    <field name="expiration_date"/>
                                </div>
                                <div>
                                    <strong>Estado:</strong>
                                    <field name="is_valid" widget="boolean"/>
                                </div>
                            </div>
                            <!-- <div class="o_kanban_record_bottom">
                                <a t-attf-href="/web/image/ir.attachment/{{record.attachment_id.id}}/datas" target="_blank" class="btn btn-primary btn-sm">
                                    <i class="fa fa-download"/> Descargar
                                </a>
                            </div> -->
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- View hr.employee.certificate form -->
    <record id="view_hr_employee_certificate_form" model="ir.ui.view">
        <field name="name">Vista Formulario de Certificado del Empleado</field>
        <field name="model">hr.employee.certificate</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="institution"/>
                            <field name="issue_date"/>
                            <field name="expiration_date"/>
                            <field name="is_valid" readonly="1"/>
                        </group>
                        <group>
                            <field name="employee_id" readonly="1"/>
                            <field name="certificate_filename" string="Nombre del archivo"/>
                            <field name="certificate_file" string="Subir certificado" 
                               filename="certificate_filename" 
                               widget="binary"
                               options="{'accepted_file_extensions': ['pdf', 'png', 'jpg', 'jpeg']}"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Descripción del certificado..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View hr.employee.certificate search -->
    <record id="view_hr_employee_certificate_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda de Certificados del Empleado</field>
        <field name="model">hr.employee.certificate</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action hr.employee.certificate -->
    <record id="action_hr_employee_certificate" model="ir.actions.act_window">
        <field name="name">Certificados de los Empleados</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.employee.certificate</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay ejemplos, haga clic aquí para agregar un nuevo Certificado de Empleado de Recursos Humanos.
            </p>
        </field>
    </record>

</odoo>
