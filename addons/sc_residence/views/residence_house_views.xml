<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View residence_house View List -->
    <record id="view_residence_house_list" model="ir.ui.view">
        <field name="name">Vista Lista de Residencias</field>
        <field name="model">residence_house</field>
        <field name="arch" type="xml">
            <list default_order="active desc, name asc">
                <field string="Activa" name="active" widget="boolean_toggle" width="80"/>
                <field string="Imagen" name="image_with_default" widget="image" width="50"/>
                <field name="name" />
                <field name="email" widget="email"/>
                <!-- <field name="phone" widget="phone" width="110"/>
                <field name="province_id" width="110"/>
                <field name="municipality_id" width="110"/> -->
            </list>
        </field>
    </record>

    <record id="view_residence_house_list_delete" model="ir.ui.view">
        <field name="name">Vista Lista de Residencias eliminadas</field>
        <field name="model">residence_house</field>
        <field name="arch" type="xml">
            <list default_order="active desc, name asc" create="false" edit="false" delete="false">
                <field string="Activa" name="active" widget="boolean_toggle" width="80"/>
                <field string="Imagen" name="image_with_default" widget="image" width="50"/>
                <field name="name" />
                <field name="email" widget="email"/>
                <!-- <field name="phone" widget="phone" width="110"/>
                <field name="province_id" width="110"/>
                <field name="municipality_id" width="110"/> -->
            </list>
        </field>
    </record>

    <!-- View residence_house form -->
    <record id="view_residence_house_form" model="ir.ui.view">
        <field name="name">Vista Formulario de Residencia</field>
        <field name="model">residence_house</field>
        <field name="arch" type="xml">
            <form string="Residence_house">
                <header>
                    <button string="Restaurar residencia" invisible="not is_deleted" name="action_restore" type="object" class="oe_highlight"/>
                    
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="Nombre"/>
                        <h1>
                            <field name="name" placeholder="Nombre ..." required="1"/>
                        </h1>
                    </div>
                    <group col="4" colspan="4">
                        <group string="Información General" col="2" colspan="2">
                            <field string="Teléfono" name="phone" widget="phone" required="1"/>
                            <field string="Correo electrónico" name="email" widget="email" required="1"/>
                            <field string="Activa" name="active" widget="boolean_toggle" />
                            <field name="schedule"
                                string="Horario de Atención"
                                placeholder="..." />
                        </group>
                        <group string="Dirección" col="2" colspan="2">
                            <group col="1" colspan="1">
                                <field string="Calle principal" name="street" placeholder="Calle principal" />
                                <field string="Entre calle #1" name="street2" placeholder="Entre calle 1" />
                                <field string="Entre calle #2" name="street3" placeholder="Entre calle 2" />
                                <field string="Número" name="street_number" placeholder="Número" />
                            </group>
                            <group col="1" colspan="1">
                                <field string="Estado" name="province_id" placeholder="Estado"
                                        class="o_address_country" />
                                <field string="Municipio" name="municipality_id"
                                        class="o_address_state"
                                        placeholder="Municipio"
                                        domain="[('province_id','=',province_id)]" />
                                <field string="Ciudad" name="city" placeholder="Ciudad"
                                        class="o_address_city" />
                            </group>
                            <group col="2" colspan="2">
                                <field name="contact_address"
                                        string="Dirección Completa"
                                        readonly="1"
                                        placeholder="Se genera automáticamente" />
                            </group>
                        </group>
                    </group>
                    <notebook>
                        <page name="services" string="Servicios">
                            <field name="services_ids" domain="[('active', '=', True)]">
                                <list>
                                    <field name="name" />
                                    <field name="description" />
                                </list>
                            </field>
                        </page>
                        <page name="description" string="Descripción">
                            <field name="description" widget="html" class="oe_inline"
                                placeholder="Detalles de la residencia..." />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="view_residence_house_form_delete" model="ir.ui.view">
        <field name="name">Vista Formulario de Residencia eliminada</field>
        <field name="model">residence_house</field>
        <field name="arch" type="xml">
            <form string="Residence_house" create="false" edit="false" delete="false">
                <header>
                    <button string="Restaurar residencia" invisible="not is_deleted" name="action_restore" type="object" class="oe_highlight"/>
                    
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="Nombre"/>
                        <h1>
                            <field name="name" placeholder="Nombre ..." required="1"/>
                        </h1>
                    </div>
                    <group col="4" colspan="4">
                        <group string="Información General" col="2" colspan="2">
                            <field string="Teléfono" name="phone" widget="phone" />
                            <field string="Correo electrónico" name="email" widget="email" />
                            <field string="Estado" name="active" widget="boolean_toggle" />
                            <field name="schedule"
                                string="Horario de Atención"
                                placeholder="..." />
                        </group>
                        <group string="Dirección" col="2" colspan="2">
                            <group col="1" colspan="1">
                                <field string="Calle principal" name="street" placeholder="Calle principal" />
                                <field string="Entre calle #1" name="street2" placeholder="Entre calle 1" />
                                <field string="Entre calle #2" name="street3" placeholder="Entre calle 2" />
                                <field string="Número" name="street_number" placeholder="Número" />
                            </group>
                            <group col="1" colspan="1">
                                <field string="Estado" name="province_id" placeholder="Estado"
                                        class="o_address_country" />
                                <field string="Municipio" name="municipality_id"
                                        class="o_address_state"
                                        placeholder="Municipio"
                                        domain="[('province_id','=',province_id)]" />
                                <field string="Ciudad" name="city" placeholder="Ciudad"
                                        class="o_address_city" />
                            </group>
                            <group col="2" colspan="2">
                                <field name="contact_address"
                                        string="Dirección Completa"
                                        readonly="1"
                                        placeholder="Se genera automáticamente" />
                            </group>
                        </group>
                    </group>
                    <notebook>
                        <page name="services" string="Servicios">
                            <field name="services_ids" domain="[('active', '=', True)]">
                                <list>
                                    <field name="name" />
                                    <field name="description" />
                                </list>
                            </field>
                        </page>
                        <page name="description" string="Descripción">
                            <field name="description" widget="html" class="oe_inline"
                                placeholder="Detalles de la residencia..." />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View residence_house search -->
    <record id="view_residence_house_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda de Residencia</field>
        <field name="model">residence_house</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="description" />
                <group expand="1" string="Agrupar por">
                    <filter string="Activo/Inactivo" name="active_notactive" domain="[]" context="{'group_by':'active'}"/>
                    <filter string="Estado" name="province_id" domain="[]" context="{'group_by':'province_id'}"/>
                    <filter string="Municipio" name="municipality_id" domain="[]" context="{'group_by':'municipality_id'}"/>
                </group>
                <filter string="Residencias activas" name="house_active" domain="[('active','=',True)]" />
                <filter string="Residencias no activas" name="house_active" domain="[('active','=',False)]" />
            </search>
        </field>
    </record>

    <!-- Action residence_house -->
    <record id="action_residence_house" model="ir.actions.act_window">
        <field name="name">Listado de Residencias</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">residence_house</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_deleted','=',False)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="search_view_id" ref="view_residence_house_search" />
        <field name="view_ids" eval="[ (5, 0, 0), 
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_residence_house_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_residence_house_form')})]"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros haga clic aquí para agregar nueva Residencias.
            </p>
        </field>
    </record>
    
    <record id="action_residence_house_deleted" model="ir.actions.act_window">
        <field name="name">Listado de Residencias eliminadas</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">residence_house</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_deleted','=',True)]</field>
        <field name="context">{'active_test': False}</field>
        <field name="search_view_id" ref="view_residence_house_search" />
        <field name="view_ids" eval="[ (5, 0, 0), 
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_residence_house_list_delete')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_residence_house_form_delete')})]"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros 
            </p>
        </field>
    </record>
</odoo>