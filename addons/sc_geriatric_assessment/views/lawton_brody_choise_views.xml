<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View lawtonbrody.choise View List -->
    <record id="view_lawtonbrody_choise_list" model="ir.ui.view">
        <field name="name">Vista Lista Opciones de Respuestas de Lawton-Brody</field>
        <field name="model">lawtonbrody.choise</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field string="Puntuación" name="value"/>
            </list>
        </field>
    </record>

    <!-- View lawtonbrody.choise form -->
    <record id="view_lawtonbrody_choise_form" model="ir.ui.view">
        <field name="name">Vista Formulario Opción de Respuestas de Lawton-Brody</field>
        <field name="model">lawtonbrody.choise</field>
        <field name="arch" type="xml">
            <form string="Lawton-Brody criterion">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"
                                   placeholder="Nombre del criterio..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field string="Puntuación" name="value"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View lawtonbrody.choise search -->
    <record id="view_lawtonbrody_choise_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda Opción de Respuestas de Lawton-Brody</field>
        <field name="model">lawtonbrody.choise</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Action lawtonbrody.choise -->
    <record id="action_lawtonbrody_choise" model="ir.actions.act_window">
        <field name="name">Criterios de las actividades de Lawton-Brody
        </field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">lawtonbrody.choise</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros, haga clic aquí para agregar una nueva
                opción de respuesta de Lawton-Brody.
            </p>
        </field>
    </record>

</odoo>
