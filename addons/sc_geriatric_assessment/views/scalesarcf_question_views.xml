<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View scalesarcf.question View List -->
    <record id="view_scalesarcf_question_list" model="ir.ui.view">
        <field name="name">Vista Lista Preguntas de SARC-F</field>
        <field name="model">scalesarcf.question</field>
        <field name="arch" type="xml">
            <list default_order="order">
                <field name="active" widget="boolean_toggle" string="Activo"/>
                <field name="order" />
                <field name="letter"/>
                <field name="name"/>
                <field name="sub_name" />
                <field name="statement"/>
                <field name="count_choises"/>
            </list>
        </field>
    </record>

    <!-- View scalesarcf.question form -->
    <record id="view_scalesarcf_question_form" model="ir.ui.view">
        <field name="name">Vista Formulario Pregunta de SARC-F</field>
        <field name="model">scalesarcf.question</field>
        <field name="arch" type="xml">
            <form string="Scalesarcf Question">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuración">
                            <field name="active" string="Activa" widget="boolean_toggle"/>
                            <field name="letter"/>
                            <field name="sub_name"/>
                            <field name="order" />
                        </group>
                        <group string="Enunciado">
                            <field name="statement" nolabel="1" widget="textarea" rows="5" />
                        </group>
                    </group>
                    <group string="Opciones de Respuestas">
                        <field nolabel="1" name="choise_ids">
                            <list>
                                <field name="name"/>
                                <field name="value"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View scalesarcf.question search -->
    <record id="view_scalesarcf_question_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda Pregunta de SARC-F</field>
        <field name="model">scalesarcf.question</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Action scalesarcf.question -->
    <record id="action_scalesarcf_question" model="ir.actions.act_window">
        <field name="name">Preguntas de SARC-F</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">scalesarcf.question</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros, haga clic aquí para agregar una nueva pregunta
                de SARC-F.
            </p>
        </field>
    </record>

</odoo>
