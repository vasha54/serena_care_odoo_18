<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="lawtonbrody_state_total_dependence"
                model="lawtonbrody.state">
            <field name="name">Dependencia severa o total</field>
            <field name="min_score">0</field>
            <field name="max_score">3</field>
        </record>

        <record id="lawtonbrody_state_moderate_dependence"
                model="lawtonbrody.state">
            <field name="name">Dependencia moderada</field>
            <field name="min_score">4</field>
            <field name="max_score">5</field>
        </record>

        <record id="lawtonbrody_state_mild_dependence"
                model="lawtonbrody.state">
            <field name="name">Dependencia leve o parcial</field>
            <field name="min_score">6</field>
            <field name="max_score">7</field>
        </record>

        <record id="lawtonbrody_state_total_independence"
                model="lawtonbrody.state">
            <field name="name">Independencia total</field>
            <field name="min_score">8</field>
            <field name="max_score">8</field>
        </record>
    </data>
</odoo>
