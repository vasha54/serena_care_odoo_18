<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View resident form -->
    <record id="view_resident_form_vital_signs" model="ir.ui.view">
        <field name="name">Vista Formulario Residente extendida Evaluaciones Neurológicas</field>
        <field name="model">resident</field>
        <field name="inherit_id" ref="sc_resident.view_resident_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//notebook[@name='notebook_evaluation']" position="inside">
                <page name="tab_neurological_assessment" string="Neurológicas" invisible="not id">
                    <group  string="Evaluaciones">

                        <field name="neurological_assessment_ids" nolabel="1" options="{'create':false, 'edit':false, 'delete':false}">
                            <list default_order="date desc" optional="show"  >
                                <field string="Fecha" name="date" width="120"/>
                                <field string="Registrado" name="user_id"/>
                                <field string="Estado neurológico" name="neurological_state_id" />
                                <field string="Descripción" name="description"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>