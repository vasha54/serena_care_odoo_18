<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View neurological.state View List -->
    <record id="view_neurological_state_list" model="ir.ui.view">
        <field name="name">Vista Lista de Estados Neurológicos</field>
        <field name="model">neurological.state</field>
        <field name="arch" type="xml">
            <list>
                <field string="Activo" name="active" widget="boolean_toggle" />
                <field string="Color" name="color" />
                <field string="Nombre" name="name"/>
                <field string="Acrónimo" name="acronym"/>
                <field string="Descripción" name="description"/>
            </list>
        </field>
    </record>

    <!-- View neurological.state form -->
    <record id="view_neurological_state_form" model="ir.ui.view">
        <field name="name">Vista Formulario de Estado Neurológico</field>
        <field name="model">neurological.state</field>
        <field name="arch" type="xml">
            <form string="Neurological State">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuración">
                            <field string="Activo" name="active" widget="boolean_toggle" />
                            <field string="Acrónimo" name="acronym"/>
                            <field string="Color" name="color" />
                        </group>
                        <group string="Descripción">
                            <field nolabel="1" name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View neurological.state search -->
    <record id="view_neurological_state_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda de Estado Neurológico</field>
        <field name="model">neurological.state</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <!-- Action neurological.state -->
    <record id="action_neurological_state" model="ir.actions.act_window">
        <field name="name">Estados neurológicos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">neurological.state</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros haga clic aquí para agregar nuevo Estado Neurológico.
            </p>
        </field>
    </record>

</odoo>
