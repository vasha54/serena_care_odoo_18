<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View nutrition View List -->
    <record id="view_nutrition_list" model="ir.ui.view">
        <field name="name">Vista Lista de Registro de Nutrición</field>
        <field name="model">nutrition</field>
        <field name="arch" type="xml">
            <list default_order="date desc" create="false" edit="false" delete="false">
                <field string="Fecha" name="date"/>
                <field string="Registrado" name="user_id" />
                <field string="Residente" name="resident_id" />
                <field name="residence_id" />
                <field string="Nivel de alimentación" name="nutrition_level_id" />
                <field string="Descripción" name="description" />
            </list>
        </field>
    </record>

    <!-- View nutrition form -->
    <record id="view_nutrition_form" model="ir.ui.view">
        <field name="name">Vista Formulario de Registro de Nutrición</field>
        <field name="model">nutrition</field>
        <field name="arch" type="xml">
            <form string="Nutrition" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <label for="resident_id"/>
                        <h1>
                            <field name="resident_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field string="Fecha" name="date" readonly="1"/>
                            <field string="Nivel" name="nutrition_level_id" readonly="1" />
                        </group>
                        <group>
                            <field string="Registrado" name="user_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Descripción" >
                        <field name="description" nolabel="1" widget="textarea" rows="7" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View nutrition search -->
    <record id="view_nutrition_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda de Registro de Nutrición</field>
        <field name="model">nutrition</field>
        <field name="arch" type="xml">
            <search>
                <field name="date"/>
                <field name="residence_id" />
                                
                <filter string="Hoy" name="today" 
                        domain="[('date','&gt;=', context_today().start_of('day')), 
                        ('date','&lt;=', context_today().end_of('day'))]"/>
                <filter string="Últimos 7 días" name="last_week" 
                        domain="[('date','&gt;=', context_today() - datetime.timedelta(days=7))]"/>
                <filter string="Último mes" name="last_month" 
                        domain="[('date','&gt;=', context_today() - datetime.timedelta(days=30))]"/>
                <filter string="Último año" name="last_year" 
                        domain="[('date','&gt;=', context_today() - datetime.timedelta(days=365))]"/>
                <filter string="Rango de fechas" name="date_range" 
                        date="date"/>
                <filter string="Agrupado por mes" name="group_by_month" 
                        context="{'group_by':'date:month'}"/>
                <filter string="Agrupado por usuario" name="group_by_user" 
                                context="{'group_by':'user_id'}"/>
                <filter string="Agrupado por residente" name="group_by_resident" 
                                context="{'group_by':'resident_id'}"/>
                <filter string="Agrupado por nivel" name="group_by_level" 
                                context="{'group_by':'nutrition_level_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action nutrition -->
    <record id="action_nutrition" model="ir.actions.act_window">
        <field name="name">Alimentación</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">nutrition</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros de alimentación.
            </p>
        </field>
    </record>

</odoo>
