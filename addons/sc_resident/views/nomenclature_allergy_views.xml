<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View nomenclature.allergy View List -->
    <record id="view_nomenclature_allergy_list_without_active" model="ir.ui.view">
        <field name="name">Vista Lista de la alergías no activas</field>
        <field name="model">nomenclature.allergy</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_nomenclature_allergy_list" model="ir.ui.view">
        <field name="name">Vista Lista de la alergías</field>
        <field name="model">nomenclature.allergy</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <list>
                <field string="Activo" name="active" widget="boolean_toggle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View nomenclature.allergy form -->
    <record id="view_nomenclature_allergy_form" model="ir.ui.view">
        <field name="name">Vista Formulario de la alergía</field>
        <field name="model">nomenclature.allergy</field>
        <field name="arch" type="xml">
            <form string="Formulario de Alergía">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                    <group>
                        <field string="Activo" name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View nomenclature.allergy search -->
    <record id="view_nomenclature_allergy_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda de la alergías</field>
        <field name="model">nomenclature.allergy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <!-- Action nomenclature.allergy -->
    <record id="action_nomenclature_allergy" model="ir.actions.act_window">
        <field name="name">Listado de Alergias</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">nomenclature.allergy</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
        eval="[ (5, 0, 0), 
            (0, 0, {'view_mode': 'list', 'view_id': ref('sc_resident.view_nomenclature_allergy_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sc_resident.view_nomenclature_allergy_form')}),]" />
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros haga clic aquí para agregar Alergía.
            </p>
        </field>
    </record>

</odoo>
