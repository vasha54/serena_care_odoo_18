<?xml version="1.0" encoding="utf-8"?>
<odoo>



    <!-- View change.photo.family.wizard form -->
    <record id="view_change_photo_family_wizard_form" model="ir.ui.view">
        <field name="name">Vista Dialogo Cambio de Foto al Familiar</field>
        <field name="model">change.photo.family.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Photo Family Wizard">
                <sheet>
                    <field name="current_family_id" invisible="1"/>
                    <group>
                        <group string="Foto actual">
                            <field name="current_image_1920" nolabel="1" widget="image"/>
                        </group>
                        <group string="Nueva foto">
                            <field name="new_image_1920" nolabel="1" widget="image"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button 
                        name="action_change_photo_family" 
                        string="Actualizar imagen" 
                        type="object" 
                        class="btn-primary"/>
                    <button 
                        string="Cancelar" 
                        special="cancel" 
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    



</odoo>
