<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_register_new_family_resident_wizard_form" model="ir.ui.view">
        <field name="name">Vista Dialogo Registrar Nuevo Familar al Residente</field>
        <field name="model">register.new.family.resident.wizard</field>
        <field name="arch" type="xml">
            <form string="Register New Family Resident Wizard">
                <sheet>
                    <field name="family_image_1920" widget="image" class="oe_avatar" 
                        options='{"preview_image": "image_128"}' />
                    <div class="oe_title">
                        <h1>
                            <field string="Nombre" name="family_name" required="1" 
                                placeholder="Nombre del familiar" class="mb-0"/>
                        </h1>
                    </div>
                    <group col="2" colspan="2">
                        <field name="is_contractor"  />
                    </group>
                    <group col="2">
                        <group string="Contacto">
                            <field name="family_phone" widget="phone" />
                            <field name="family_mobile" widget="phone" />
                            <field name="family_email" widget="email" />
                            <field name="kinship_id" />
                        </group>
                        <group string="Dirección">
                            <field name="family_address" rows="5" widget="textarea" nolabel="1" required="1" />
                        </group>
                    </group>
                    <group col="2" colspan="2" string="Niveles de autorización">
                        <field name="auth_level_ids" nolabel="1"  widget="many2many_tags" 
                        required="1"
                        />
                    </group>
                </sheet>
                <footer>
                    <button 
                        name="action_create_family" 
                        string="Registrar familiar" 
                        type="object" 
                        class="btn-primary"/>
                    <button 
                        string="Cancelar" 
                        special="cancel" 
                        class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    
</odoo>
