<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_update_resident_age" model="ir.cron">
            <field name="name">Serena Care -Actualización diaria de edades de residentes</field>
            <field name="model_id" ref="model_resident"/>
            <field name="state">code</field>
            <field name="code">model._cron_update_age()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 00:00:00')"/>
            <field name="priority">6</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>