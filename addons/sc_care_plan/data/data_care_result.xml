        <record id="care_result_1" model="care.result">
            <field name="name">Lograr una ingesta adecuada con calidad y cantidad, cumpliendo con los requerimientos energéticos.</field>
            <field name="activity_type_ids"
                   eval="[(6, 0, [ref('sc_care_plan.type_avd_eating')])]"/>
            <field name="dependency_level_ids"
                   eval="[(6, 0, [ref('sc_care_plan.dlevel_total'),ref('sc_care_plan.dlevel_half'),ref('sc_care_plan.dlevel_low')])]"/>
        </record>
