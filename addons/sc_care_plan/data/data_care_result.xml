                   eval="[(6, 0, [ref('sc_care_plan.type_avd_body_hygiene')])]"/>
            <field name="dependency_level_ids"
                   eval="[(6, 0, [ref('sc_care_plan.dlevel_total'),ref('sc_care_plan.dlevel_half'),ref('sc_care_plan.dlevel_low')])]"/>
        </record>
        <record id="care_result_3" model="care.result">
            <field name="name">Mantener la salud y vitalidad en óptimas condiciones del Residente con detección oportuna de retención.</field>
