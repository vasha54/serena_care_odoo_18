    <!-- View care.plan search -->
    <record id="view_care_plan_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda de Plan de Cuidado</field>
        <field name="model">care.plan</field>
        <field name="arch" type="xml">
            <search>
                <field string="Nombre del plan" name="display_name"/>
            </search>
        </field>
    </record>

    <!-- Action care.plan -->
    <record id="action_care_plan" model="ir.actions.act_window">
        <field name="name">Planes de cuidados</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">care.plan</field>
        <field name="view_mode">list</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros de planes de cuidado.
            </p>
        </field>
    </record>

</odoo>
