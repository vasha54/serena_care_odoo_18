<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View care.plan View List -->
    <record id="view_care_plan_list" model="ir.ui.view">
        <field name="name">Vista de Lista de Planes de Cuidado</field>
        <field name="model">care.plan</field>
        <field name="arch" type="xml">
            <list create="false">
                <field string="Plan" name="display_name"/>
                <field name="count_activitys" />
                <field name="count_dependency_level" />
                <field name="count_goals" />
                <field name="count_actions" />
                <field name="count_observations" />
                <field name="count_results" />
            </list>
        </field>
    </record>

    <!-- View care.plan form -->
