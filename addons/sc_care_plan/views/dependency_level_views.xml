<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View dependency.level View List -->
    <record id="view_dependency_level_list" model="ir.ui.view">
        <field name="name">Vista de Lista Niveles de Dependencia</field>
        <field name="model">dependency.level</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="view_dependency_level_list_active" model="ir.ui.view">
        <field name="name">Vista de Lista Niveles de Dependencia columna Activo</field>
        <field name="model">dependency.level</field>
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <list>
                <field string="Activo" name="active" widget="boolean_toggle"/> 
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View dependency.level form -->
    <record id="view_dependency_level_form" model="ir.ui.view">
        <field name="name">Vista Formulario de Nivel de Dependencia</field>
        <field name="model">dependency.level</field>
        <field name="arch" type="xml">
            <form string="Dependency Level">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nombre ..."/>
                        </h1>
                    </div>
                    <group>
                        <field string="Activo" name="active" widget="boolean_toggle"/>                    
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View dependency.level search -->
    <record id="view_dependency_level_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda de Nivel de Dependencia</field>
        <field name="model">dependency.level</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <group expand="1" string="Agrupar por">
                    <filter string="Activo/Inactivo" name="active_notactive" domain="[]" context="{'group_by':'active'}"/>
                </group>
                <filter string="Nivel de Dependencia activos" name="result_active" domain="[('active','=',True)]" />
                <filter string="Nivel de Dependencia no activos" name="result_not_active" domain="[('active','=',False)]" />
                
            </search>
        </field>
    </record>

    <!-- Action dependency.level -->
    <record id="action_dependency_level" model="ir.actions.act_window">
        <field name="name">Niveles de dependencia</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">dependency.level</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
        eval="[ (5, 0, 0), 
            (0, 0, {'view_mode': 'list', 'view_id': ref('sc_care_plan.view_dependency_level_list_active')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('sc_care_plan.view_dependency_level_form')}),]" />
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay ejemplos, haga clic aquí para agregar un nuevo nivel de dependencia.
            </p>
        </field>
    </record>

</odoo>
