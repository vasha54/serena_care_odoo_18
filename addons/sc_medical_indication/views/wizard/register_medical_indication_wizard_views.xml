<?xml version="1.0" encoding="utf-8"?>
<odoo>

    

    <!-- View register.medical.indication.wizard form -->
    <record id="view_register_medical_indication_wizard_form" model="ir.ui.view">
        <field name="name">Vista Wizard-Formulario registrar Indicación Médica General</field>
        <field name="model">register.medical.indication.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Medical Indication Wizard">
                <sheet>
                    <group col="2" colspan="2">
                        <group>
                            <field name="current_resident_id" readonly="1" />
                            <field name="user_id" readonly="1" />
                            <field name="date" readonly="1" />
                        </group>
                        <group>
                            <group string="Indicación" col="2" colspan="2">
                                <field required="1" name="note" rows="7" widget="textarea" nolabel="1" placeholder="Detalles de la indicación"/>
                            </group>
                        </group>
                    </group>
                    <footer>
                        <button 
                            name="action_register_medical_indication" 
                            string="Registrar indicación" 
                            type="object" 
                            class="btn-primary"/>
                        <button 
                            string="Cancelar" 
                            special="cancel" 
                            class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>


</odoo>
