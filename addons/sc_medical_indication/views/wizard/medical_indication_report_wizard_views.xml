<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_medical_indication_report_wizard" model="ir.ui.view">
        <field name="name">Vista Wizard de reporte de Indicación Médica</field>
        <field name="model">medical.indication.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Reporte de Indicaciones Médicas">
                <sheet>
                    <group>
                        <group>
                            <field name="resident_id" widget="many2one" options="{'no_open': True, 'no_create': True}" readonly="1"/>
                        </group>
                        <group>
                            <field name="quantity"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="generate_report" string="Generar PDF" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_medical_indication_report_wizard" model="ir.actions.act_window">
        <field name="name">Generar Reporte de Indicaciones Médicas</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">medical.indication.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
