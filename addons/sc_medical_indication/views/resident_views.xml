<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View resident form -->
    <record id="view_resident_form_vital_signs" model="ir.ui.view">
        <field name="name">Vista Formulario Residente extendida Indicación Médica</field>
        <field name="model">resident</field>
        <field name="inherit_id" ref="sc_resident.view_resident_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//notebook[@name='notebook_medical_history']" position="inside">
                <page name="medical_indication" string="Indicaciones Médicas" invisible="not id">
                    <group colspan="4" col="4">
                        <group name="label_add_medical_indication" string="Registrar indicación" >
                            <group>
                                <button 
                                    name="open_register_medical_indication_wizard" 
                                    string="General" 
                                    type="object"
                                    class="btn-primary"
                                    groups="sc_group.gs_admin,sc_group.gs_gerente_salud,sc_group.gs_coordinator_nurse"
                                    invisible="not id or show_actions_buttons"/>
                                
                                <button 
                                    name="open_register_medical_medication_wizard" 
                                    string="Medicamento" 
                                    type="object"
                                    class="btn-primary"
                                    invisible="not id or show_actions_buttons"
                                    groups="sc_group.gs_admin,sc_group.gs_gerente_salud,sc_group.gs_coordinator_nurse"/>
                            </group>               
                        </group>
                        <!-- <group  string="Reporte">
                            <group>
                                <button name="action_open_medical_indication_report_wizard" 
                                        string="Indicaciones" 
                                        type="object" 
                                        class="oe_stat_button"
                                        icon="fa-file-pdf-o"/>
                            </group>
                        </group> -->
                    </group>
                    <group colspan="4" col="4" string="Registros">

                        <notebook>
                            <page  string="Generales">
                                <field name="medical_indication_general_ids" options="{'delete':false}" nolabel="1">
                                    <list default_order="create_date desc" optional="show" export_xlsx="true" export_csv="true">
                                        <field string="Fecha/Hora" name="create_date"  />
                                        <field name="user_id" />
                                        <field name="note" />
                                    </list>
                                </field>
                            </page>

                            <page  string="Medicamentos">
                                <field name="medical_indication_medication_ids" options="{'delete':false}" nolabel="1">
                                    <list default_order="create_date desc" optional="show" export_xlsx="true" export_csv="true">
                                        <field string="Fecha/Hora" name="create_date"/>
                                        <field name="user_id"/>
                                        <!-- <field name="resident_id"/>
                                        <field name="medicament_id" />
                                        <field name="pharmaceutical_form" />
                                        <field name="route_id" />
                                        <field name="dosage_str" />
                                        <field name="frequency_str" />
                                        <field name="period_medication" /> -->
                                        <field name="note" />
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>