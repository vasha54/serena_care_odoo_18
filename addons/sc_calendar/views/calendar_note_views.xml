<?xml version="1.0" encoding="utf-8"?>
<odoo>   
    <record id="calendar_note_view_form" model="ir.ui.view">
        <field name="name">Vista Formulario de Notas en el Calendario</field>
        <field name="model">calendar.note</field>
        <field name="arch" type="xml">
            <form string="">
                <sheet>
                    <div class="oe_title">
                        <label for="resident_id"/>
                        <h2>
                            <field name="resident_id" readonly="1"/>
                                         
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field string="Título" name="name" />
                            <field name="event_type" />
                        </group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="start_date" />
                        </group>
                    </group>
                    <group name="group_doctor" string="Cita médica con:" invisible="event_type != 'appointment_doctor'"
                    >
                        <group>
                            <field name="doctor_id" required="event_type == 'appointment_doctor'"/>
                        </group>
                        <group>
                            <field name="specialty_doctor" />
                        </group>
                    </group>
                    <group string="Descripción">
                        <field name="description" widget="textarea" nolabel="1" rows="4"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_calendar_note_calendar" model="ir.ui.view">
        <field name="name">Vista Calenedario de las Notas de Calendario</field>
        <field name="model">calendar.note</field>
        <field name="arch" type="xml">
            <calendar string="Notas Calendariadas"
                      date_start="start_date"
                      event_open_popup="true"
                      mode="month"
                      color="event_type"
                      form_view_id="calendar_note_view_form"
                      quick_create="false"> 
                <field name="name"/>
                <field name="user_id"/>
                <field name="description_compute"/>
            </calendar>
        </field>
    </record>

    <record id="action_calendar_note_wizard" model="ir.actions.act_window">
        <field name="name">Ver Calendario de Notas</field>
        <field name="res_model">calendar.note</field>
        <field name="view_mode">calendar</field>
        <field name="view_id" ref="view_calendar_note_calendar"/>
        <field name="target">new</field> <!-- This makes it open as a popup -->
        <field name="context">{
            'search_default_resident_id': active_id,
            'default_resident_id': active_id
        }</field>
        <field name="domain">[('resident_id', '=', active_id)]</field>
    </record>
</odoo>
