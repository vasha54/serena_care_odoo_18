<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View medicament.product View List -->
    <record id="view_medicament_product_list" model="ir.ui.view">
        <field name="name">Vista Lista Medicamentos</field>
        <field name="model">medicament.product</field>
        <field name="arch" type="xml">
            <list>
                <!-- <field string="Estado" name="active" widget="boolean_toggle"/>  -->
                <field string="Clave" name="code"/>
                <field string="Nombre" name="name"/>
                <field string="Marca comercial" name="brand_commercial"/>
                <field string="Grupo" name="category"/> 
                <field string="Forma Farmacéutica" name="pharmaceutical_form" />
                <field name="others_details_presentation" string="Otros detalles de la presentación"/>
                <field name="composicion" string="Composición"/>
                <field name="indications" string="Indicaciones"/>
                <field name="dosage" string="Vías de administración y Dosis"/>
            </list>
        </field>
    </record>

    <!-- View medicament.product form -->
    <record id="view_medicament_product_form" model="ir.ui.view">
    <field name="name">Vista Formulario Medicamento</field>
    <field name="model">medicament.product</field>
    <field name="arch" type="xml">
        <form string="Medicament Product">
            <header>
                <!-- <button 
                        name="toggle_active" 
                        type="object"
                        class="oe_highlight btn-danger"
                        invisible="not active or not id" 
                        string="Desactivar medicamento"
                    />                    
                <button 
                        name="toggle_active" 
                        type="object"
                        class="oe_highlight btn-success"
                        invisible="active or not id" 
                        string="Activar medicamento"
                    /> -->
            </header>
            <sheet>
                <field name="active" invisible="1" />
                <field name="image_1920" widget="image" class="oe_avatar" options="{&quot;preview_image&quot;: &quot;avatar_128&quot;}"/>
                <div class="oe_title">
                    <label string="Nombre" for="name"/>
                    <h1><field name="name" placeholder="e.g. Insulina" required="1"/></h1>
                    <label for="category" string="Grupo"/>
                    <h2><field name="category" /></h2>
                </div>
                <group>
                    <field name="code" string="Clave" placeholder="XXX.XXX.XXXX.XX "/>
                    <field string="Marca comercial" name="brand_commercial"/>
                </group>
                <notebook>
                    <page name="presentation_medicament" string="Presentación">
                        <group col="3" colspan="3">
                            <group col="1" colspan="1" >
                                <group  string="Forma Farmacéutica">
                                    <field name="pharmaceutical_form" nolabel="1"/>
                                </group>
                                <group  string="Otros Detalles">
                                    <field name="others_details_presentation" rows="7" widget="textarea" nolabel="1" placeholder="Otros detalles del medicamento"/>
                                </group>
                            </group>
                            <group col="2" colspan="2">
                                <group col="2" colspan="2" string="Composición">
                                    <field name="composicion" nolabel="1" rows="9"               
                                            widget="textarea" placeholder="Composición"/>
                                </group>
                            </group>
                        </group>
                    </page>
                    <page name="indication_medicament" string="Indicaciones">
                        <group col="1" colspan="1">
                            <field name="indications" rows="9" widget="textarea" placeholder="Indicaciones del medicamento" nolabel="1"/>
                        </group>
                    </page>
                    <page name="route_dosage" string="Vías de administración y Dosis">
                        <group col="1" colspan="1">
                            <field name="dosage" nolabel="1"
                                   rows="9" widget="textarea" placeholder="Vías de administración y Dosis"/>
                                
                        </group>
                    </page>
                </notebook>
                
                
            </sheet>
            <div class="oe_chatter">
                <!-- <field name="message_follower_ids" widget="mail_followers"/>
                <field name="activity_ids" widget="mail_activity"/> -->
                <!-- <field name="message_ids" widget="mail_thread"/> -->
            </div>
        </form>
    </field>
</record>

    <!-- View medicament.product search -->
    <record id="view_medicament_product_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda Medicamento</field>
        <field name="model">medicament.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <group expand="0" string="Agrupar por:">
                    <filter string="Grupo" name="filter_category" domain="[]" context="{'group_by':'category'}"/>
                    <filter string="Forma Farmacéutica" name="filter_pharmaceutical_form" domain="[]" context="{'group_by':'pharmaceutical_form'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action medicament.product -->
    <record id="action_medicament_product" model="ir.actions.act_window">
        <field name="name">Listado de medicamentos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">medicament.product</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros haga clic aquí para agregar nuevo Medicamento
            </p>
        </field>
    </record>

</odoo>
