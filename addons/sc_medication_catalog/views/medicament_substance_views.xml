<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View medicament.substance View List -->
    <record id="view_medicament_substance_list" model="ir.ui.view">
        <field name="name">Vista Lista Principios activo o excipiente</field>
        <field name="model">medicament.substance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View medicament.substance form -->
    <record id="view_medicament_substance_form" model="ir.ui.view">
        <field name="name">Vista Formulario Principio activo o excipiente</field>
        <field name="model">medicament.substance</field>
        <field name="arch" type="xml">
            <form string="Medicament Substance">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nombre ..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View medicament.substance search -->
    <record id="view_medicament_substance_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda Principio activo o excipiente</field>
        <field name="model">medicament.substance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <!-- Action medicament.substance -->
    <record id="action_medicament_substance" model="ir.actions.act_window">
        <field name="name">Principios activos o excipientes</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">medicament.substance</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros haga clic aquí para agregar nuevo Principio activo o Excipiente presente en los medicamentos.
            </p>
        </field>
    </record>

</odoo>
