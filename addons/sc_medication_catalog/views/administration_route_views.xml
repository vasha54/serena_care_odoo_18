<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View administration.route View List -->
    <record id="view_administration_route_list" model="ir.ui.view">
        <field name="name">Vista Lista Vías de Administración del Medicamento</field>
        <field name="model">administration.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View administration.route form -->
    <record id="view_administration_route_form" model="ir.ui.view">
        <field name="name">Vista Formulario Vía de Administración del Medicamento</field>
        <field name="model">administration.route</field>
        <field name="arch" type="xml">
            <form string="Administration Route">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nombre ..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View administration.route search -->
    <record id="view_administration_route_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda Vía de Administración del Medicamento</field>
        <field name="model">administration.route</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action administration.route -->
    <record id="action_administration_route" model="ir.actions.act_window">
        <field name="name">Vías de administración</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">administration.route</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros haga clic aquí para agregar nueva Vía de Administración
            </p>
        </field>
    </record>

</odoo>
