<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View medicament.category View List -->
    <record id="view_product_category_list" model="ir.ui.view">
        <field name="name">Vista Lista Categorías de Medicamento</field>
        <field name="model">product.category</field>
        <field name="arch" type="xml">
            <list>
                <field string="Nombre" name="display_name"/>
            </list>
        </field>
    </record>

    <!-- View medicament.category form -->
    <record id="view_product_category_form" model="ir.ui.view">
        <field name="name">Vista Formulario Categoría de Medicamento</field>
        <field name="model">product.category</field>
        <field name="arch" type="xml">
            <form string="Medicament Category" context="{'medicament_category':True}">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nombre ..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="parent_id" domain="[('is_medicament_category', '=', True)]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View medicament.category search -->
    <record id="view_product_category_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda Categoría de Medicamento</field>
        <field name="model">product.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- Action medicament.category -->
    <record id="action_product_category" model="ir.actions.act_window">
        <field name="name">Grupos de Medicamentos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_medicament_category','=',True)]</field>
        <field name="context">{'medicament_category': True}</field>
        <field name="search_view_id" ref="view_product_category_search" />
        <field name="view_ids" eval="[ (5, 0, 0), 
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_product_category_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_product_category_form')})]"/>
        
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros haga clic aquí para agregar nuevo Grupo de Medicamento
            </p>
        </field>
    </record>

</odoo>
