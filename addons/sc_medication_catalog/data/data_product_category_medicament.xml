<odoo>
    <data noupdate="1">
        <!-- Categorías principales según Cuadro Básico 2018 -->
        <record id="categoria_medicamentos_alopaticos" model="medicament.category">
            <field name="name">Medicamentos alopáticos</field>
        </record>
        
        <!-- Grupos terapéuticos según Cuadro Básico 2018 -->
        <record id="grupo_analgesicos" model="medicament.category">
            <field name="name">Analgésicos y antipiréticos</field>
        </record>
        <record id="grupo_antibioticos" model="medicament.category">
            <field name="name">Antibióticos y quimioterapéuticos</field>
        </record>
        <record id="grupo_antiinflamatorios" model="medicament.category">
            <field name="name">Antiinflamatorios no esteroideos</field>
        </record>
        <record id="grupo_antihipertensivos" model="medicament.category">
            <field name="name">Antihipertensivos</field>
        </record>
        <record id="grupo_antidiabeticos" model="medicament.category">
            <field name="name">Antidiabéticos</field>
        </record>
        
        <!-- Categorías especiales del Catálogo 2018 -->
        <record id="categoria_medicamentos_controlados" model="medicament.category">
            <field name="name">Medicamentos controlados</field>
        </record>
        <record id="categoria_medicamentos_biologicos" model="medicament.category">
            <field name="name">Biológicos</field>
        </record>
        <record id="categoria_medicamentos_herbolarios" model="medicament.category">
            <field name="name">Medicamentos herbolarios</field>
        </record>
        
        <!-- Subgrupos para medicamentos controlados -->
        <record id="subgrupo_psicotropos" model="medicament.category">
            <field name="name">Psicotrópicos (Fracción III)</field>
        </record>
        <record id="subgrupo_estupefacientes" model="medicament.category">
            <field name="name">Estupefacientes (Fracción II)</field>
        </record>
        
        <!-- Categorías de alto impacto en salud pública -->
        <record id="categoria_vacunas" model="medicament.category">
            <field name="name">Vacunas</field>
        </record>
        <record id="categoria_antivirales" model="medicament.category">
            <field name="name">Antivirales</field>
        </record>
        <record id="categoria_antirretrovirales" model="medicament.category">
            <field name="name">Antirretrovirales</field>
        </record>
        
        <!-- Categorías de soporte vital -->
        <record id="categoria_hemoderivados" model="medicament.category">
            <field name="name">Hemoderivados</field>
        </record>
        <record id="categoria_soluciones_inyectables" model="medicament.category">
            <field name="name">Soluciones inyectables</field>
        </record>
        
        <!-- Categorías complementarias -->
        <record id="categoria_medicamentos_huerfanos" model="medicament.category">
            <field name="name">Medicamentos huérfanos</field>
        </record>
        <record id="categoria_medicamentos_esenciales" model="medicament.category">
            <field name="name">Medicamentos esenciales</field>
        </record>
    </data>
</odoo>