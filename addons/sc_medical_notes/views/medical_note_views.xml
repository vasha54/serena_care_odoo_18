<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View medical.note View List -->
    <record id="view_medical_note_list" model="ir.ui.view">
        <field name="name">Vista Lista Notas Médica</field>
        <field name="model">medical.note</field>
        <field name="arch" type="xml">
            <list default_order="date desc">
                <field string="Fecha" name="date"/>
                <field string="Registrado" name="user_id"/>
                <field string="Residente" name="resident_id"/>
                <field name="residence_id" />
                <field string="Descripción" name="description"/>
            </list>
        </field>
    </record>

    <!-- View medical.note form -->
    <record id="view_medical_note_form" model="ir.ui.view">
        <field name="name">Vista Formulario Nota Médica</field>
        <field name="model">medical.note</field>
        <field name="arch" type="xml">
            <form string="Nota de enfermería">
                <sheet>
                    <div class="oe_title">
                        <label for="resident_id"/>
                        <h1>
                            <field name="resident_id" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field string="Fecha" name="date" readonly="1"/>
                        </group>
                        <group>
                            <field string="Registrado" name="user_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Descripción">
                        <field name="description" nolabel="1" widget="textarea" rows="7" required="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View medical.note search -->
    <record id="view_medical_note_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda Nota Médica</field>
        <field name="model">medical.note</field>
        <field name="arch" type="xml">
            <search>
                <field name="residence_id" />
            </search>
        </field>
    </record>

    <!-- Action medical.note -->
    <record id="action_medical_note" model="ir.actions.act_window">
        <field name="name">Notas médicas</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">medical.note</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros de nota médica.
            </p>
        </field>
    </record>

</odoo>
