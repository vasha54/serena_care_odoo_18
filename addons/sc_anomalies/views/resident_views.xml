<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View resident form -->
    <record id="view_resident_form_vital_signs" model="ir.ui.view">
        <field name="name">Vista Formulario de Residente extendida Registros de Anomalías</field>
        <field name="model">resident</field>
        <field name="inherit_id" ref="sc_resident.view_resident_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//notebook[@name='daily_follow_up']" position="inside">
                <page name="tab_anomaly" string="Anomalías" invisible="not id">
                    <group  string="Registros">

                        <field name="anomaly_ids" nolabel="1" options="{'create':false, 'edit':false, 'delete':false}">
                            <list default_order="date desc" optional="show"  >
                                <field string="Fecha" name="date" width="120"/>
                                <field string="Registrado" name="user_id"/>
                                <field string="Nivel de anomalía" name="anomaly_level_id" />
                                <field string="Descripción" name="description"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>