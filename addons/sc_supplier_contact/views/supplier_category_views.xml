<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View supplier.category View List -->
    <record id="view_supplier_category_list" model="ir.ui.view">
        <field name="name">Vista Lista de Categoría de Proovedores</field>
        <field name="model">supplier.category</field>
        <field name="arch" type="xml">
            <list default_order="active desc, name asc">
                <field string="Estado" name="active" widget="boolean_toggle"/>
                <field name="name"/>
                <field name="description" />
            </list>
        </field>
    </record>

    <!-- View supplier.category form -->
    <record id="view_supplier_category_form" model="ir.ui.view">
        <field name="name">Vista Formulario de Categoría de Proovedor</field>
        <field name="model">supplier.category</field>
        <field name="arch" type="xml">
            <form string="Supplier Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nombre del servicio..."/>
                        </h1>
                    </div>
                    <group>
                        <field string="Estado" name="active" widget="boolean_toggle" />
                        <field string="Descripción" name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View supplier.category search -->
    <record id="view_supplier_category_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda de Categoría de Proovedor</field>
        <field name="model">supplier.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="description" />
                <group expand="1" string="Agruar por">
                    <filter string="Activo" name="active" domain="[]" context="{'group_by':'active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action supplier.category -->
    <record id="action_supplier_category" model="ir.actions.act_window">
        <field name="name">Categoría de los proveedores</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">supplier.category</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros haga clic aquí para agregar nueva Categoría de Proveedor.
            </p>
        </field>
    </record>

</odoo>
