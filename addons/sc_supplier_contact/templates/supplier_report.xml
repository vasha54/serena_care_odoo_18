<?xml version="1.0" encoding="utf-8"?>
<odoo>
<template id="report_supplier">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2>Reporte de Proveedores</h2>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Tipo</th>
                                <th>Teléfono</th>
                                <th>Dirección</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="supplier">
                                <td><span t-field="supplier.name"/></td>
                                <td>
                                    <span t-esc="dict(supplier._fields['provider_type'].selection).get(supplier.provider_type)"/>
                                </td>
                                <td><span t-field="supplier.phone"/></td>
                                <td><span t-field="supplier.contact_address"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>