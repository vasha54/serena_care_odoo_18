<?xml version="1.0" encoding="utf-8"?>
<odoo>

    

    <!-- View register.water.balance.wizard form -->
    <record id="view_register_water_balance_wizard_form" model="ir.ui.view">
        <field name="name">Vista de Wizard para Registrar anotación en el Balance Hídrico</field>
        <field name="model">register.water.balance.wizard</field>
        <field name="arch" type="xml">
            <form string="Register water Balance Wizard">
                <sheet>
                    <div class="oe_title">
                        <label for="resident_id"/>
                        <h1>
                            <field name="resident_id" readonly="1"/>
                        </h1>
                    </div>
                    <group col="2" colspan="2">
                            <group col="1"  colspan="1">
                                <field name="type_annotation" readonly="1"/>
                                <field name="route_id" />
                                <field name="quantity" />
                            </group>
                            <group col="1" colspan="1">
                                <group string="Observaciones">
                                    <field name="notes" nolabel="1" />
                                </group>
                            </group>
                    </group>
                    <footer>
                        <button 
                            name="action_register_annotation" 
                            string="Registrar" 
                            type="object" 
                            class="btn-primary"/>
                        <button 
                            string="Cancelar" 
                            special="cancel" 
                            class="btn-secondary"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>



    

</odoo>
