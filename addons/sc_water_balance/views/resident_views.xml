<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View resident form -->
    <record id="view_resident_form_water_balance" model="ir.ui.view">
        <field name="name">Vista Formulario Residente extendida Balance Hídrico</field>
        <field name="model">resident</field>
        <field name="inherit_id" ref="sc_resident.view_resident_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//notebook[@name='daily_follow_up']" position="inside">
                <page name="water_balance" string="Balance Hídrico" invisible="not id">
                    <group colspan="4" col="4">
                        <group name="label_add_water_balance"
                               string="Registrar" >
                            <group>
                                <button 
                                    name="open_register_income_wizard" 
                                    string="Ingreso" 
                                    type="object"
                                    class="btn-primary"
                                    groups="sc_group.gs_admin,sc_group.gs_gerente_salud,sc_group.gs_enfermeria"
                                    invisible="not id or show_actions_buttons"/>
                                
                                <button 
                                    name="open_register_expense_wizard" 
                                    string="Egreso" 
                                    type="object"
                                    class="btn-primary"
                                    groups="sc_group.gs_admin,sc_group.gs_gerente_salud,sc_group.gs_enfermeria"
                                    invisible="not id or show_actions_buttons"/>
                            </group>               
                        </group>
                        <group name="group_water_balance_calculate" string="Balance general hídrico" col="2" colspan="2">
                            <field name="total_water_balance" nolabel="1"/>
                            <field name="status_water_balance" nolabel="1"/>
                            <button name="open_compute_water_balance_range_wizard" 
                                        string="Calcular en intervalo" 
                                        type="object" 
                                        class="btn-primary"
                                        groups="sc_group.gs_admin,sc_group.gs_gerente_salud,sc_group.gs_enfermeria"
                                        icon="fa-calculator"/>
                        </group>
                       
                    </group>
                    <notebook name="water_balance_records_graph">
                        <page name="record_water_balance_list"  string="Registros">
                            <field name="water_balance_ids" options="{'create':false, 'delete':false}" nolabel="1">
                                <list default_order="date desc" optional="show" export_xlsx="true" export_csv="true">
                                    <field string="Fecha/Hora" name="date"/>
                                    <field string="Registrado" name="user_id"/>
                                    <field name="type_annotation" />
                                    <field name="route_id" />
                                    <field name="quantity" />
                                    <field name="notes" />
                                </list>
                            </field>
                        </page>
                    </notebook>

                </page>
            </xpath>
        </field>
    </record>

</odoo>
