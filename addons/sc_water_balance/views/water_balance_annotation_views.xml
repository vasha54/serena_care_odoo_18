<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View water.balance.annotation View List -->
    <record id="view_water_balance_annotation_list" model="ir.ui.view">
        <field name="name">view.water.balance.annotation.list</field>
        <field name="model">water.balance.annotation</field>
        <field name="arch" type="xml">
            <list default_order="create_date desc">
                <field string="Fecha/Hora" name="create_date"/>
                <field string="Registrado" name="user_id"/>
                <field string="Residente" name="resident_id"/>
                <field name="type_annotation" />
                <field name="route_id" />
                <field name="quantity" />
                <field name="notes" />
            </list>
        </field>
    </record>

    <!-- View water.balance.annotation form -->
    <record id="view_water_balance_annotation_form" model="ir.ui.view">
        <field name="name">view.water.balance.annotation.form</field>
        <field name="model">water.balance.annotation</field>
        <field name="arch" type="xml">
            <form string="water Balance Annotation">
                <sheet>
                    <div class="oe_title">
                        <label for="resident_id"/>
                        <h1>
                            <field name="resident_id"/>
                        </h1>
                    </div>
                        <group col="2" colspan="2">
                            <group col="1"  colspan="1">
                                <field name="type_annotation" />
                                <field name="route_id" />
                                <field name="quantity" />
                            </group>
                            <group col="1"  colspan="1">
                                <group string="Observaciones">
                                    <field name="notes" nolabel="1" />
                                </group>
                            </group>
                        </group>
                    
                </sheet>
            </form>
        </field>
    </record>

    <!-- View water.balance.annotation search -->
    <record id="view_water_balance_annotation_search" model="ir.ui.view">
        <field name="name">view.water.balance.annotation.search</field>
        <field name="model">water.balance.annotation</field>
        <field name="arch" type="xml">
            <search>
                <field name="create_date"/>
                <field name="quantity"/>
                                
                <filter string="Hoy" name="today" 
                        domain="[('create_date','&gt;=', context_today().start_of('day')), 
                        ('create_date','&lt;=', context_today().end_of('day'))]"/>
                <filter string="Últimos 7 días" name="last_week" 
                        domain="[('create_date','&gt;=', context_today() - datetime.timedelta(days=7))]"/>
                <filter string="Último mes" name="last_month" 
                        domain="[('create_date','&gt;=', context_today() - datetime.timedelta(days=30))]"/>
                <filter string="Último año" name="last_year" 
                        domain="[('create_date','&gt;=', context_today() - datetime.timedelta(days=365))]"/>
                <filter string="Rango de fechas" name="date_range" 
                        date="create_date"/>
                <filter string="Agrupado por mes" name="group_by_month" 
                        context="{'group_by':'create_date:month'}"/>
                <filter string="Agrupado por usuario" name="group_by_user" 
                                context="{'group_by':'user_id'}"/>
                <filter string="Agrupado por residente" name="group_by_resident" 
                                context="{'group_by':'resident_id'}"/>
            </search>
        </field>
    </record>

    <!-- Action water.balance.annotation -->
    <record id="action_water_balance_annotation" model="ir.actions.act_window">
        <field name="name">Registros del Balance Hídricos</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">water.balance.annotation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros haga clic aquí para agregar nuevo registro del Balance Hídrido.
            </p>
        </field>
    </record>

</odoo>
