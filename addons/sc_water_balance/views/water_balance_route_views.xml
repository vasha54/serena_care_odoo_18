<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View water.balance.route View List -->
    <record id="view_water_balance_route_list" model="ir.ui.view">
        <field name="name">Vista Lista de Vías de Ingreso/Egreso de Líquido</field>
        <field name="model">water.balance.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View water.balance.route form -->
    <record id="view_water_balance_route_form" model="ir.ui.view">
        <field name="name">Vista Formulario de Vía de Ingreso/Egreso de Líquido</field>
        <field name="model">water.balance.route</field>
        <field name="arch" type="xml">
            <form string="water Balance Route">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Nombre..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View water.balance.route search -->
    <record id="view_water_balance_route_search" model="ir.ui.view">
        <field name="name">Vista Búsqueda de Vía de Ingreso/Egreso de Líquido</field>
        <field name="model">water.balance.route</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <!-- Action water.balance.route -->
    <record id="action_water_balance_route" model="ir.actions.act_window">
        <field name="name">Vía de Ingreso/Egreso</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">water.balance.route</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No hay registros haga clic aquí para agregar nueva Vía de Ingreso/Egreso
            </p>
        </field>
    </record>

</odoo>
