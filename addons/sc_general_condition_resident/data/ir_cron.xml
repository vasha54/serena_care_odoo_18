<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Tarea programada para ejecutar cada 12 horas -->
        <record id="cron_update_general_status" model="ir.cron">
            <field name="name">Actualización automática del estado general de residentes</field>
            <field name="model_id" ref="model_resident"/>
            <field name="state">code</field>
            <field name="code">model._update_general_status_check()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
        
    </data>
</odoo>